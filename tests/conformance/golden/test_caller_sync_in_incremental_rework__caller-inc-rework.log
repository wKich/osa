---
sandbox
exec
-n
repo-app
--no-login-shell
--
sh
-c
set -e
gitdir=$1 worktree=$2 keepgit=$3
if [ "$keepgit" -eq 0 ]; then
    rm -rf "$worktree/.git"
fi
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
export GIT_AUTHOR_NAME=maki-oss GIT_AUTHOR_EMAIL=maki-oss@localhost
export GIT_COMMITTER_NAME=maki-oss GIT_COMMITTER_EMAIL=maki-oss@localhost
mkdir -p "$gitdir"
git init -q
git add -A
tree=$(git write-tree)
commit=$(git commit-tree "$tree" -m "maki-oss caller baseline")
git update-ref refs/maki-oss/caller-base "$commit"
files=$(git ls-tree -r "$tree" | wc -l | tr -d " ")
bytes=$(git ls-tree -r -l "$tree" | awk "{ s += \$4 } END { printf \"%d\", s }")
printf "%s %s %s\n" "$commit" "$files" "$bytes"
maki-oss-git
