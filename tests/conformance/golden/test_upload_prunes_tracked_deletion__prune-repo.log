---
sandbox
exec
-n
maki-repo
--no-login-shell
--workdir
<case>/sandbox/project
--
sh
-c
set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
export GIT_AUTHOR_NAME=maki-oss GIT_AUTHOR_EMAIL=maki-oss@localhost
export GIT_COMMITTER_NAME=maki-oss GIT_COMMITTER_EMAIL=maki-oss@localhost
mkdir -p "$gitdir" "$worktree"
git init -q
git add -A
tree=$(git write-tree)
commit=$(git commit-tree "$tree" -m "maki-oss baseline")
git update-ref refs/maki-oss/base "$commit"
printf "%s\n" "$tree"
maki-oss-git
<case>/sandbox/.maki-oss/git
<case>/sandbox/project
@env MAKI_OSS_IDLE_STOP
@env MAKI_OSS_IMAGE
@env MAKI_OSS_INTERACTIVE
@env MAKI_OSS_POLICY
@env MAKI_OSS_PROVIDERS
@env MAKI_OSS_RUN_TAG
@env MAKI_OSS_SANDBOX_NAME
@env MAKI_OSS_TEST_ENV_VALUE
@env MAKI_OSS_TIMEOUT
@env MAKI_OSS_TUI
@env MAKI_OSS_WORKDIR
@env MAKI_OSS_WORKSPACE
