git update-ref refs/maki-oss/result "$commit"
git diff --binary --full-index refs/maki-oss/base refs/maki-oss/result maki-oss-git <case>/sandbox/.maki-oss/git <case>/sandbox/project
sandbox exec -n maki-myproject --no-login-shell --workdir <case>/sandbox/project -- sh -c set -e
export GIT_DIR=$1
git rev-parse -q --verify refs/maki-oss/result^{tree} 2>/dev/null || true maki-oss-git <case>/sandbox/.maki-oss/git <case>/sandbox/project
