@env MAKI_OSS_IDLE_STOP
@env MAKI_OSS_IMAGE
@env MAKI_OSS_INTERACTIVE
@env MAKI_OSS_POLICY
@env MAKI_OSS_PROVIDERS
@env MAKI_OSS_RUN_TAG
@env MAKI_OSS_SANDBOX_NAME
@env MAKI_OSS_TEST_ENV_VALUE
@env MAKI_OSS_TIMEOUT
@env MAKI_OSS_TUI
@env MAKI_OSS_WORKDIR
@env MAKI_OSS_WORKSPACE
@env MAKI_VERSION
---
sandbox
exec
-n
repo-app
--no-login-shell
--
sh
-c
set -e
worktree=$2 prev=$3 cur=$4 dirty=$5 filter=$6 history=$7
tmp=${TMPDIR:-<tmp>}/maki-oss-inc.$$
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp"
awk -F "\t" 'NR==FNR {
    if (FNR > 1 && $1 != "complete") pm[$5] = 1
    next
}
FNR > 1 && $1 != "complete" {
    delete pm[$5]
}
END {
    for (p in pm) print p
}' "$prev" "$cur" > "$tmp/deleted"
while IFS= read -r path; do
    case $path in
        ""|/*|..|../*|*/..|*/../*) continue ;;
    esac
    target=$worktree/$path
    if [ -f "$target" ] || [ -L "$target" ]; then
        rm -f -- "$target"
    fi
done < "$tmp/deleted"
awk -F "\t" 'FNR > 1 && $1 != "complete" { print $5 }' "$cur" \
    | LC_ALL=C sort -u > "$tmp/current"
awk -F "\t" 'FNR > 1 && $1 != "complete" { print $5 }' "$prev" \
    | LC_ALL=C sort -u > "$tmp/previous"
find "$worktree" -mindepth 1 -path "$worktree/.git" -prune -o \
    \( -type f -o -type l \) -print \
    | awk -v p="$worktree/" 'index($0, p) == 1 { print substr($0, length(p) + 1) }' \
    | LC_ALL=C sort -u > "$tmp/work"
comm -23 "$tmp/work" "$tmp/current" > "$tmp/notcurrent"
comm -23 "$tmp/notcurrent" "$tmp/previous" > "$tmp/leftover"
while IFS= read -r path; do
    case $path in
        ""|/*|..|../*|*/..|*/../*) continue ;;
    esac
    if [ "$filter" = gitignore ] \
        && git -C "$worktree" check-ignore -q --no-index -- "$path" 2>/dev/null; then
        continue
    fi
    target=$worktree/$path
    if [ -f "$target" ] || [ -L "$target" ]; then
        rm -f -- "$target"
    fi
done < "$tmp/leftover"
if [ "$history" != git ]; then
    rm -rf -- "$worktree/.git"
fi
find "$worktree" -mindepth 1 -depth -type d ! -path "$worktree/.git" \
    -exec rmdir -- {} \; 2>/dev/null || true
rm -f -- "$cur"
maki-oss-git
