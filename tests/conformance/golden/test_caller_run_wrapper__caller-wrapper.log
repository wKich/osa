---
sandbox
list
--output
json
@env MAKI_OSS_IDLE_STOP
@env MAKI_OSS_IMAGE
@env MAKI_OSS_INTERACTIVE
@env MAKI_OSS_POLICY
@env MAKI_OSS_PROVIDERS
@env MAKI_OSS_RUN_TAG
@env MAKI_OSS_SANDBOX_NAME
@env MAKI_OSS_TEST_ENV_VALUE
@env MAKI_OSS_TIMEOUT
@env MAKI_OSS_TUI
@env MAKI_OSS_WORKDIR
@env MAKI_OSS_WORKSPACE
@env MAKI_VERSION
---
sandbox
provider
list
repo-app
--output
json
@env MAKI_OSS_IDLE_STOP
@env MAKI_OSS_IMAGE
@env MAKI_OSS_INTERACTIVE
@env MAKI_OSS_POLICY
@env MAKI_OSS_PROVIDERS
@env MAKI_OSS_RUN_TAG
@env MAKI_OSS_SANDBOX_NAME
@env MAKI_OSS_TEST_ENV_VALUE
@env MAKI_OSS_TIMEOUT
@env MAKI_OSS_TUI
@env MAKI_OSS_WORKDIR
@env MAKI_OSS_WORKSPACE
@env MAKI_VERSION
---
sandbox
exec
-n
repo-app
--no-login-shell
--workdir
<case>/sandbox/tasks/t1
--
sh
-c
tag=$1; secs=$2; shift 2
stop=<tmp>/<entry>/$tag
rm -f "$stop"
export MAKI_OSS_RUN_TAG="$tag"
exec 3<&0
timeout --kill-after=10 "$secs" "$@" <&3 3<&- &
exec 3<&-
child=$!
while kill -0 "$child" 2>/dev/null; do
    if [ -e "$stop" ]; then kill -TERM "$child" 2>/dev/null; break; fi
    sleep 1
done
wait "$child"
rc=$?
unset MAKI_OSS_RUN_TAG
for d in /proc/[0-9]*; do
    if grep -qzx "MAKI_OSS_RUN_TAG=$tag" "$d/environ" 2>/dev/null; then
        kill -KILL "${d#/proc/}" 2>/dev/null
    fi
done
rm -f "$stop"
exit "$rc"
maki-oss-run
oskhs-t1
30
maki
--print
--yolo
--trust
--output-format
stream-json
--verbose
q
@env MAKI_OSS_IDLE_STOP
@env MAKI_OSS_IMAGE
@env MAKI_OSS_INTERACTIVE
@env MAKI_OSS_POLICY
@env MAKI_OSS_PROVIDERS
@env MAKI_OSS_RUN_TAG
@env MAKI_OSS_SANDBOX_NAME
@env MAKI_OSS_TEST_ENV_VALUE
@env MAKI_OSS_TIMEOUT
@env MAKI_OSS_TUI
@env MAKI_OSS_WORKDIR
@env MAKI_OSS_WORKSPACE
@env MAKI_VERSION
