const AGENT_TAGS = ["mk", "oc", "cc", "cx"];
const KEBAB = /^[a-z0-9]+(-[a-z0-9]+)*$/;

/** `provider setup TAG --profile ID [--name N] [--attach S] [--yes] --json`, or null. */
function setupArgs(argv: string[]): { agent: string; profile: string; name: string | null; attach: string | null; yes: boolean } | null {
  if (argv[0] !== "provider" || argv[1] !== "setup" || !AGENT_TAGS.includes(argv[2] ?? "")) return null;
  if (argv[3] !== "--profile" || !KEBAB.test(argv[4] ?? "")) return null;
  let index = 5;
  let name: string | null = null;
  let attach: string | null = null;
  let yes = false;
  if (argv[index] === "--name") {
    name = argv[index + 1] ?? "";
    if (!KEBAB.test(name)) return null;
    index += 2;
  }
  if (argv[index] === "--attach") {
    attach = argv[index + 1] ?? "";
    if (!attach) return null;
    index += 2;
  }
  if (argv[index] === "--yes") {
    yes = true;
    index += 1;
  }
  if (argv[index] !== "--json" || index + 1 !== argv.length) return null;
  return { agent: argv[2]!, profile: argv[4]!, name, attach, yes };
}

const stateDir = env.STUB_OSA_STATE || (env.STUB_OSA_FIXTURE ? join(dirname(env.STUB_OSA_FIXTURE), "stub-osa-state") : "");

function stateFiles(prefix: string): string[] {
  if (!stateDir || !existsSync(stateDir)) return [];
  return readdirSync(stateDir)
    .filter((name) => name.startsWith(prefix))
    .map((name) => name.slice(prefix.length));
}

function markState(name: string): void {
  if (!stateDir) return;
  mkdirSync(stateDir, { recursive: true });
  writeFileSync(join(stateDir, name), "");
}

function readFixture(): Record<string, any> {
  return env.STUB_OSA_FIXTURE && existsSync(env.STUB_OSA_FIXTURE)
    ? JSON.parse(readFileSync(env.STUB_OSA_FIXTURE, "utf8"))
    : {};
}

if (args.length === 2 && args[0] === "images" && args[1] === "--json") {
  const built = stateFiles("built-");
  const images = (readFixture().images ?? IMAGE_FIXTURES).map((image: Record<string, any>) =>
    built.includes(image.agent)
      ? { ...image, present: true, id: "sha256:built", created: "2026-10-27T12:00:00Z", error: null }
      : image,
  );
  process.stdout.write(`${JSON.stringify(images)}\n`);
  process.exit(0);
}

if (args.length === 3 && args[0] === "image" && args[1] === "build" && AGENT_TAGS.includes(args[2]!)) {
  const tag = args[2]!;
  const builds = readFixture().build ?? {};
  const plan = builds[tag] ?? builds.default ?? {};
  const mode = plan.mode ?? "lines";
  const text = plan.text ?? "Step";
  if (mode === "sleep" || mode === "ignore-term") {
    process.on("SIGTERM", () => {
      if (mode === "sleep") {
        process.stdout.write("stub osa: build cancelled\n");
        process.exit(143);
      }
    });
    process.stdout.write(`${text} 1: building ${tag}\n`);
    setInterval(() => {}, 1000);
    await new Promise(() => {});
  }
  const count = plan.lines ?? 3;
  const interval = (plan.interval ?? 0.05) * 1000;
  for (let index = 1; index <= count; index += 1) {
    const line = `${text} ${index}/${count}: building ${tag}\n`;
    if (index % 2 === 0) process.stderr.write(line);
    else process.stdout.write(line);
    if (interval > 0) await Bun.sleep(interval);
  }
  const exit = plan.exit ?? 0;
  if (exit === 0) markState(`built-${tag}`);
  process.exit(exit);
}

if (args.length === 2 && args[0] === "providers" && args[1] === "--json") {
  const providers = (readFixture().providers ?? PROVIDER_FIXTURES).map((entry: Record<string, any>) => {
    const created = stateFiles(`provider-${entry.agent}-`);
    if (!Array.isArray(entry.gateway) || created.length === 0) return entry;
    return { ...entry, gateway: [...new Set([...entry.gateway, ...created])] };
  });
  process.stdout.write(`${JSON.stringify(providers)}\n`);
  process.exit(0);
}

const setup = setupArgs(args);
if (setup) {
  const input = await new Response(Bun.stdin.stream()).text();
  if (env.STUB_OSA_STDIN_LOG) {
    appendFileSync(env.STUB_OSA_STDIN_LOG, `${JSON.stringify({ argv: args, bytes: new TextEncoder().encode(input).length })}\n`);
  }
  const plans = readFixture().setup ?? {};
  const plan = plans[setup.profile] ?? plans.default ?? {};
  let mode: string = plan.mode ?? (setup.yes ? "updated" : "created");
  const provider = setup.name ?? setup.profile;
  const result = (fields: Record<string, unknown>) =>
    `${JSON.stringify({
      ok: false,
      agent: setup.agent,
      provider,
      profile: setup.profile,
      outcome: "refused",
      attached: null,
      remembered: false,
      steps: [],
      message: "",
      ...fields,
    })}\n`;
  if (mode === "slow") {
    await Bun.sleep((plan.delay ?? 30) * 1000);
    mode = "created";
  } else if (plan.delay) {
    await Bun.sleep(plan.delay * 1000);
  }
  const steps = (outcome: string) => ["linted", "imported", outcome, "remembered", ...(setup.attach ? ["attached"] : [])];
  switch (mode) {
    case "refused":
      process.stderr.write(`maki-oss: provider '${provider}' already exists; pass --yes to update its credential\n`);
      process.stdout.write(result({ message: `provider '${provider}' already exists; pass --yes to update its credential; nothing changed` }));
      process.exit(2);
    case "usage":
      process.stdout.write(result({ message: "provider setup --stdin read an empty credential; nothing changed" }));
      process.exit(1);
    case "failed":
      markState(`provider-${setup.agent}-${provider}`);
      process.stderr.write("stub: attach timed out waiting for the supervisor\n");
      process.stdout.write(
        result({
          outcome: "failed",
          remembered: true,
          steps: ["linted", "imported", "created", "remembered"],
          message: `created ${provider} and remembered it; attach to '${setup.attach ?? "?"}' failed: stub: attach timed out waiting for the supervisor`,
        }),
      );
      process.exit(3);
    case "echo-secret":
      markState(`provider-${setup.agent}-${provider}`);
      process.stderr.write(`stub osa: received ${input}\n`);
      process.stdout.write(
        result({ ok: true, outcome: "created", remembered: true, steps: steps("created"), attached: setup.attach, message: `created ${provider} with ${input}` }),
      );
      process.exit(0);
    default: {
      const outcome = mode === "updated" ? "updated" : "created";
      markState(`provider-${setup.agent}-${provider}`);
      const what = outcome === "created" ? `created ${provider}` : `updated the credential of ${provider}`;
      process.stdout.write(
        result({
          ok: true,
          outcome,
          remembered: true,
          steps: steps(outcome),
          attached: setup.attach,
          message: `${what} and remembered it${setup.attach ? `, attached to ${setup.attach}` : ""}`,
        }),
      );
      process.exit(0);
    }
  }
}

const quick = args[0] === "status" && args.length === 4 && args[2] === "--quick" && args[3] === "--json";
const health = args[0] === "health" && args.length === 3 && args[2] === "--json";
const full = args[0] === "status" && args.length === 3 && args[2] === "--json";
const resolve =
  args[0] === "resolve" &&
  args[3] === "--json" &&
  (args.length === 4 || (args.length === 5 && args[4] === "--yes"));
if (!(quick || full || health || resolve)) {
  process.stderr.write(`stub osa: unsupported argv: ${args.join(" ")}\n`);
  process.exit(1);
}

const delay = Number(env.STUB_OSA_DELAY || "0");
if (delay > 0) await Bun.sleep(delay * 1000);

const fixture =
  env.STUB_OSA_FIXTURE && existsSync(env.STUB_OSA_FIXTURE)
    ? JSON.parse(readFileSync(env.STUB_OSA_FIXTURE, "utf8"))
    : {};

if (health) {
  const sandbox = args[1]!;
  const answer = fixture.health?.[sandbox] ?? {};
  const report = answer.report ?? HEALTH_FIXTURES[sandbox];
  if (answer.delay) await Bun.sleep(answer.delay * 1000);
  if (answer.stderr) process.stderr.write(`${answer.stderr}\n`);
  if (!report && answer.exit === undefined) {
    process.stderr.write(`osa: sandbox '${sandbox}' is not registered; run 'osa projects' to list sandboxes\n`);
    process.exit(1);
  }
  if (report) process.stdout.write(`${JSON.stringify(report)}\n`);
  process.exit(answer.exit ?? 0);
}

if (resolve) {
  const [, sandbox, action] = args as [string, string, string];
  const answer = fixture.resolve?.[sandbox]?.[action] ?? {
    exit: 2,
    message: `stub osa: no resolve answer for ${sandbox} ${action}`,
  };
  const exit = answer.exit ?? 0;
  if (answer.delay) await Bun.sleep(answer.delay * 1000);
  if (answer.stderr) process.stderr.write(`${answer.stderr}\n`);
  if (exit === 0) for (const path of answer.remove ?? []) rmSync(path, { force: true });
  const result = {
    sandbox,
    action,
    ok: exit === 0,
    changed: answer.changed ?? [],
    message: answer.message ?? "",
  };
  process.stdout.write(answer.raw ?? `${JSON.stringify(result)}\n`);
  process.exit(exit);
}

const answer = fixture[args[1]!]?.[quick ? "quick" : "full"] ?? [];
const entries = quick
  ? answer.map((entry: Record<string, unknown>) => ({ idle: idle("none", null, null), ...entry }))
  : answer;
process.stdout.write(`${JSON.stringify(entries)}\n`);
