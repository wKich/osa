sandbox
provider
list
cc-myproject
--output
json
---
sandbox
exec
-n
cc-myproject
--no-login-shell
--workdir
<case>/sandbox/project
--
sh
-c
tag=$1; secs=$2; shift 2
stop=<tmp>/<entry>/$tag
rm -f "$stop"
export CLAUDE_OSS_RUN_TAG="$tag"
exec 3<&0
timeout --kill-after=10 "$secs" "$@" <&3 3<&- &
exec 3<&-
child=$!
while kill -0 "$child" 2>/dev/null; do
    if [ -e "$stop" ]; then kill -TERM "$child" 2>/dev/null; break; fi
    sleep 1
done
wait "$child"
rc=$?
unset CLAUDE_OSS_RUN_TAG
for d in /proc/[0-9]*; do
    if grep -qzx "CLAUDE_OSS_RUN_TAG=$tag" "$d/environ" 2>/dev/null; then
        kill -KILL "${d#/proc/}" 2>/dev/null
    fi
done
rm -f "$stop"
exit "$rc"
claude-oss-run
claude-oss-<pid>-<epoch>
30
