#!/bin/sh
# Stub openshell CLI for tests/run-tests.sh.
#
# Records argv to $STUB_LOG (one argument per line, invocations separated by
# "---") and simulates the subset of the CLI that maki-oss uses. Sandbox state
# lives under $STUB_STATE_DIR/sandboxes (one file per sandbox, containing its
# phase) and $STUB_STATE_DIR/providers (attached provider names).
#
# Environment knobs:
#   STUB_LOG              file to append argv to
#   STUB_STATE_DIR        directory holding simulated state
#   STUB_EXEC_STDOUT      default stdout for `sandbox exec` (default: stub-exec-output)
#   STUB_EXEC_EXIT        default exit code for `sandbox exec` (default: 0)
#   STUB_EXEC_CASES       optional file of per-command exec overrides, one
#                         `substr|exit|stdout-file` per line (first line whose
#                         substr appears in the exec argv wins; empty
#                         stdout-file prints nothing). Unmatched commands fall
#                         back to STUB_EXEC_STDOUT/STUB_EXEC_EXIT
#   STUB_GATEWAY_DOWN     "1" makes every command fail as if unreachable
#   STUB_PROVIDER_NAMES   newline-separated names for `provider list`
#   STUB_PROFILE_NAMES    newline-separated ids for `profile list`
#   STUB_PROFILE_LINT_EXIT  exit code for `profile lint` (default: 0)
#   STUB_CREDENTIAL_ENV   env var whose value is appended to STUB_ENV_LOG on
#                         `provider create|update` (default: none)
#   STUB_ENV_LOG          file receiving recorded credential env values
#   STUB_DOWNLOAD_EXIT    exit code for `sandbox download` (default: 0)
#   STUB_DOWNLOAD_FIXTURE host directory whose contents are copied into the
#                         `sandbox download` destination, simulating files
#                         changed inside the sandbox
#   STUB_JSON_COMPACT     "1" makes `sandbox list` and `sandbox provider list`
#                         emit single-line compact JSON (no space after `:`)
#   STUB_CREATE_RACE      "1" makes `sandbox create` register the sandbox in
#                         state and then fail as if a concurrent run won
#   STUB_SETTINGS_EXIT    exit code for `settings` (default: 0)
#   STUB_RULE_EXIT        exit code for `rule` (default: 0)
#   STUB_RULE_PENDING     text printed by `rule get --status pending`; the
#                         default prints a header with zero chunks
#   STUB_POLICY_FULL      text printed by `policy get --full` (default: a
#                         one-line stub policy)
#   STUB_SANDBOX_ROOT     host directory simulating the sandbox filesystem;
#                         `sandbox upload` copies into it and `download`
#                         copies back out of it
#   STUB_MAKI_SCRIPT      shell snippet run in the workdir when the exec
#                         command is `maki` or `opencode` (simulates agent
#                         changes)
#   STUB_EXEC_STDIN_LOG   file receiving the stdin of agent `sandbox exec`
#                         calls (internal sync scripts excluded), so tests
#                         can assert a closed stdin
#   STUB_EXEC_SCRIPT_FAIL substring; an internal `sh -c` script containing it
#                         fails as a sandbox error (simulates collection or
#                         baseline failures)

set -eu

if [ -n "${STUB_LOG:-}" ]; then
    {
        printf '%s\n' '---'
        for stub_arg in "$@"; do
            printf '%s\n' "$stub_arg"
        done
    } >> "$STUB_LOG"
fi

if [ "${STUB_GATEWAY_DOWN:-0}" = 1 ]; then
    printf 'stub: gateway unreachable\n' >&2
    exit 1
fi

state=${STUB_STATE_DIR:-}
sandboxes=$state/sandboxes
providers=$state/providers
nl='
'

# Appends a provider name to the simulated gateway provider list.
stub_record_provider() {
    if [ -n "$state" ] && [ -n "$1" ]; then
        mkdir -p "$state"
        printf '%s\n' "$1" >> "$state/providers.list"
    fi
}

# Records the configured credential env var's value so tests can assert that
# the value travelled in the child environment (it never appears in argv).
stub_record_credential() {
    if [ -n "${STUB_CREDENTIAL_ENV:-}" ] && [ -n "${STUB_ENV_LOG:-}" ]; then
        printf '%s\n' "$(printenv "$STUB_CREDENTIAL_ENV" 2>/dev/null || true)" >> "$STUB_ENV_LOG"
    fi
}

# Stable ID for a simulated sandbox. A create writes a fresh one, so a
# delete/recreate cycle looks like a new instance to the helper.
stub_sandbox_id() { # NAME
    if [ -n "$state" ] && [ -f "$state/ids/$1" ]; then
        cat "$state/ids/$1"
    else
        printf 'id-%s\n' "$1"
    fi
}

if [ "${1:-}" = "-g" ] || [ "${1:-}" = "--gateway" ]; then
    shift
    if [ "$#" -gt 0 ]; then
        shift
    fi
fi

command_name=${1:-}
if [ "$#" -gt 0 ]; then
    shift
fi

case $command_name in
    sandbox)
        action=${1:-}
        if [ "$#" -gt 0 ]; then
            shift
        fi
        case $action in
            create)
                sandbox_name=
                sandbox_providers=
                while [ "$#" -gt 0 ]; do
                    case $1 in
                        --name)
                            sandbox_name=${2:-}
                            shift
                            ;;
                        --provider)
                            if [ -n "$sandbox_providers" ]; then
                                sandbox_providers="$sandbox_providers$nl${2:-}"
                            else
                                sandbox_providers=${2:-}
                            fi
                            shift
                            ;;
                    esac
                    shift
                done
                if [ -z "$state" ]; then
                    printf 'stub: STUB_STATE_DIR is not set\n' >&2
                    exit 2
                fi
                mkdir -p "$sandboxes" "$providers"
                if [ "${STUB_CREATE_RACE:-0}" = 1 ] && [ ! -e "$sandboxes/$sandbox_name" ]; then
                    # A concurrent run won: the sandbox now exists, but this
                    # create loses.
                    printf 'Ready\n' > "$sandboxes/$sandbox_name"
                    printf '%s\n' "$sandbox_providers" > "$providers/$sandbox_name"
                    printf 'stub: sandbox %s already exists\n' "$sandbox_name" >&2
                    exit 1
                fi
                if [ -e "$sandboxes/$sandbox_name" ]; then
                    printf 'stub: sandbox %s already exists\n' "$sandbox_name" >&2
                    exit 1
                fi
                printf 'Ready\n' > "$sandboxes/$sandbox_name"
                printf '%s\n' "$sandbox_providers" > "$providers/$sandbox_name"
                mkdir -p "$state/ids"
                printf 'id-%s-%s-%s\n' "$sandbox_name" "$(date +%s)" "$$" \
                    > "$state/ids/$sandbox_name"
                printf 'stub: created %s\n' "$sandbox_name"
                ;;
            list)
                if [ -z "$state" ]; then
                    printf 'stub: STUB_STATE_DIR is not set\n' >&2
                    exit 2
                fi
                if [ "${STUB_JSON_COMPACT:-0}" = 1 ]; then
                    stub_compact=1
                    printf '{"next_page_token":"","sandboxes":['
                else
                    stub_compact=0
                    printf '{\n  "next_page_token": "",\n  "sandboxes": ['
                fi
                stub_first=1
                if [ -d "$sandboxes" ]; then
                    for stub_entry in "$sandboxes"/*; do
                        if [ ! -e "$stub_entry" ]; then
                            continue
                        fi
                        stub_name=$(basename "$stub_entry")
                        stub_phase=$(cat "$stub_entry")
                        stub_id=$(stub_sandbox_id "$stub_name")
                        if [ "$stub_first" -eq 0 ]; then
                            printf ','
                        fi
                        stub_first=0
                        if [ "$stub_compact" -eq 1 ]; then
                            printf '{"id":"%s","name":"%s","phase":"%s"}' \
                                "$stub_id" "$stub_name" "$stub_phase"
                        else
                            printf '\n    {"id": "%s", "name": "%s", "workspace": "default", "labels": {}, "annotations": {}, "resource_version": 1, "created_at": "2026-01-01 00:00:00", "phase": "%s", "current_policy_version": 1, "exit_code": null, "conditions": []}' \
                                "$stub_id" "$stub_name" "$stub_phase"
                        fi
                    done
                fi
                if [ "$stub_compact" -eq 1 ]; then
                    printf ']}\n'
                else
                    printf '\n  ]\n}\n'
                fi
                ;;
            start)
                sandbox_name=${1:-}
                if [ ! -e "$sandboxes/$sandbox_name" ]; then
                    printf 'stub: sandbox %s not found\n' "$sandbox_name" >&2
                    exit 1
                fi
                printf 'Ready\n' > "$sandboxes/$sandbox_name"
                ;;
            get)
                stub_get_name=${1:-}
                stub_get_output=table
                while [ "$#" -gt 0 ]; do
                    case $1 in
                        -o|--output)
                            stub_get_output=${2:-table}
                            shift
                            ;;
                        --output=*)
                            stub_get_output=${1#--output=}
                            ;;
                    esac
                    shift
                done
                if [ -z "$stub_get_name" ] || [ ! -e "$sandboxes/$stub_get_name" ]; then
                    printf 'stub: sandbox %s not found\n' "$stub_get_name" >&2
                    exit 1
                fi
                stub_get_phase=$(cat "$sandboxes/$stub_get_name")
                stub_get_id=$(stub_sandbox_id "$stub_get_name")
                if [ "$stub_get_output" = json ]; then
                    printf '{"id":"%s","name":"%s","phase":"%s"}\n' \
                        "$stub_get_id" "$stub_get_name" "$stub_get_phase"
                else
                    printf 'Sandbox:\n\n  Id: %s\n  Name: %s\n  Phase: %s\n' \
                        "$stub_get_id" "$stub_get_name" "$stub_get_phase"
                fi
                ;;
            stop)
                sandbox_name=${1:-}
                if [ ! -e "$sandboxes/$sandbox_name" ]; then
                    printf 'stub: sandbox %s not found\n' "$sandbox_name" >&2
                    exit 1
                fi
                printf 'Stopped\n' > "$sandboxes/$sandbox_name"
                ;;
            delete)
                sandbox_name=${1:-}
                rm -f "$sandboxes/$sandbox_name" "$providers/$sandbox_name"
                if [ -n "$state" ]; then
                    rm -f "$state/ids/$sandbox_name"
                fi
                ;;
            exec)
                stub_exec_args=$*
                if [ -n "${STUB_EXEC_CASES:-}" ] && [ -f "$STUB_EXEC_CASES" ]; then
                    while IFS='|' read -r stub_key stub_exit stub_file; do
                        [ -n "$stub_key" ] || continue
                        case "$stub_exec_args" in
                            *"$stub_key"*)
                                if [ -n "$stub_file" ]; then
                                    cat "$stub_file"
                                fi
                                exit "$stub_exit"
                                ;;
                        esac
                    done <"$STUB_EXEC_CASES"
                fi
                stub_workdir=
                while [ "$#" -gt 0 ]; do
                    case $1 in
                        -n)
                            shift
                            ;;
                        --workdir)
                            stub_workdir=${2:-}
                            shift
                            ;;
                        --)
                            shift
                            break
                            ;;
                    esac
                    shift
                done
                # Internal sandbox scripts (argv0 <program>-git) run locally
                # so the stub suite exercises the real git baseline and patch
                # logic. The timeout wrapper (argv0 <program>-run) is not one
                # of them.
                stub_internal=0
                case ${4:-} in
                    *-oss-git) stub_internal=1 ;;
                esac
                if [ "${1:-}" = sh ] && [ "${2:-}" = -c ] && [ "$stub_internal" -eq 1 ]; then
                    stub_script=$3
                    shift 3
                    if [ -n "${STUB_EXEC_SCRIPT_FAIL:-}" ]; then
                        case $stub_script in
                            *"$STUB_EXEC_SCRIPT_FAIL"*)
                                printf 'stub: sandbox script failed\n' >&2
                                exit 1
                                ;;
                        esac
                    fi
                    # The simulated sandbox has its own tools even when the
                    # host PATH deliberately omits git or patch.
                    PATH="${STUB_SANDBOX_TOOLS:+$STUB_SANDBOX_TOOLS:}$PATH" \
                        sh -c "$stub_script" "$@"
                    exit $?
                fi
                if [ -n "${STUB_EXEC_STDIN_LOG:-}" ]; then
                    cat >"$STUB_EXEC_STDIN_LOG"
                fi
                case ${1:-} in
                    maki|opencode|claude)
                        if [ -n "${STUB_MAKI_SCRIPT:-}" ] && [ -n "$stub_workdir" ]; then
                            ( cd "$stub_workdir" && sh -c "$STUB_MAKI_SCRIPT" )
                        fi
                        ;;
                esac
                printf '%s\n' "${STUB_EXEC_STDOUT:-stub-exec-output}"
                exit "${STUB_EXEC_EXIT:-0}"
                ;;
            upload)
                stub_no_ignore=0
                while [ "$#" -gt 0 ]; do
                    case $1 in
                        --no-git-ignore)
                            stub_no_ignore=1
                            shift
                            ;;
                        *)
                            break
                            ;;
                    esac
                done
                stub_upload_src=${2:-}
                stub_upload_dest=${3:-}
                if [ -n "${STUB_SANDBOX_ROOT:-}" ] && [ -n "$stub_upload_dest" ] && [ -e "$stub_upload_src" ]; then
                    if [ -d "$stub_upload_src" ]; then
                        mkdir -p "$stub_upload_dest"
                        if [ "$stub_no_ignore" -eq 0 ] \
                            && command -v git >/dev/null 2>&1 \
                            && git -C "$stub_upload_src" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
                            git -C "$stub_upload_src" ls-files -co --exclude-standard \
                                | while IFS= read -r stub_upload_file; do
                                    [ -e "$stub_upload_src/$stub_upload_file" ] || continue
                                    mkdir -p "$(dirname -- "$stub_upload_dest/$stub_upload_file")"
                                    cp -p "$stub_upload_src/$stub_upload_file" "$stub_upload_dest/$stub_upload_file"
                                done
                        else
                            for stub_upload_entry in "$stub_upload_src"/* "$stub_upload_src"/.[!.]* "$stub_upload_src"/..?*; do
                                [ -e "$stub_upload_entry" ] || continue
                                case $(basename -- "$stub_upload_entry") in
                                    .git) continue ;;
                                esac
                                cp -R "$stub_upload_entry" "$stub_upload_dest/"
                            done
                        fi
                    else
                        mkdir -p "$(dirname -- "$stub_upload_dest")"
                        cp -p "$stub_upload_src" "$stub_upload_dest"
                    fi
                fi
                printf 'stub: upload ok\n'
                ;;
            download)
                if [ "${STUB_DOWNLOAD_EXIT:-0}" -ne 0 ]; then
                    printf 'stub: download failed\n' >&2
                    exit "${STUB_DOWNLOAD_EXIT}"
                fi
                stub_download_src=${2:-}
                stub_download_dest=${3:-}
                if [ -n "${STUB_SANDBOX_ROOT:-}" ] && [ -n "$stub_download_src" ]; then
                    case $stub_download_src in
                        "$STUB_SANDBOX_ROOT"/*)
                            if [ -d "$stub_download_src" ]; then
                                mkdir -p "$stub_download_dest"
                                cp -R "$stub_download_src"/. "$stub_download_dest"/
                            elif [ -f "$stub_download_src" ]; then
                                mkdir -p "$(dirname -- "$stub_download_dest")"
                                cp -p "$stub_download_src" "$stub_download_dest"
                            else
                                printf 'stub: sandbox path not found: %s\n' "$stub_download_src" >&2
                                exit 1
                            fi
                            ;;
                    esac
                fi
                if [ -n "${STUB_DOWNLOAD_FIXTURE:-}" ]; then
                    # Args after the action: NAME SOURCE DEST.
                    if [ -n "$stub_download_dest" ]; then
                        mkdir -p "$stub_download_dest"
                        cp -R "$STUB_DOWNLOAD_FIXTURE"/. "$stub_download_dest"/
                    fi
                fi
                printf 'stub: download ok\n'
                ;;
            provider)
                provider_action=${1:-}
                if [ "$#" -gt 0 ]; then
                    shift
                fi
                case $provider_action in
                    list)
                        sandbox_name=${1:-}
                        if [ "${STUB_JSON_COMPACT:-0}" = 1 ]; then
                            printf '{"next_page_token":"","providers":['
                        else
                            printf '{\n  "next_page_token": "",\n  "providers": ['
                        fi
                        stub_first=1
                        if [ -n "$state" ] && [ -f "$providers/$sandbox_name" ]; then
                            while IFS= read -r stub_provider; do
                                if [ -z "$stub_provider" ]; then
                                    continue
                                fi
                                if [ "$stub_first" -eq 0 ]; then
                                    printf ','
                                fi
                                stub_first=0
                                if [ "${STUB_JSON_COMPACT:-0}" = 1 ]; then
                                    printf '{"name":"%s","type":"stub"}' "$stub_provider"
                                else
                                    printf '\n    {"name": "%s", "type": "stub", "credential_keys": [], "config_keys": []}' \
                                        "$stub_provider"
                                fi
                            done < "$providers/$sandbox_name"
                        fi
                        if [ "${STUB_JSON_COMPACT:-0}" = 1 ]; then
                            printf ']}\n'
                        else
                            printf '\n  ]\n}\n'
                        fi
                        ;;
                    attach)
                        sandbox_name=${1:-}
                        provider_name=${2:-}
                        if [ ! -e "$sandboxes/$sandbox_name" ]; then
                            printf 'stub: sandbox %s not found\n' "$sandbox_name" >&2
                            exit 1
                        fi
                        if [ -n "$state" ]; then
                            printf '%s\n' "$provider_name" >> "$providers/$sandbox_name"
                        fi
                        printf 'stub: attached %s to %s\n' "$provider_name" "$sandbox_name"
                        ;;
                    *)
                        printf 'stub: unsupported sandbox provider action\n' >&2
                        exit 1
                        ;;
                esac
                ;;
            *)
                printf 'stub: unsupported sandbox action: %s\n' "$action" >&2
                exit 1
                ;;
        esac
        ;;
    status)
        printf '{\n  "status": "connected",\n  "gateway": "stub",\n  "version": "0.1.2-stub"\n}\n'
        ;;
    provider)
        action=${1:-}
        if [ "$#" -gt 0 ]; then
            shift
        fi
        case $action in
            list)
                provider_names=${STUB_PROVIDER_NAMES:-}
                if [ -n "$state" ] && [ -f "$state/providers.list" ]; then
                    provider_names=$(printf '%s\n%s' "$provider_names" "$(cat "$state/providers.list")")
                fi
                if [ "${1:-}" = "--names" ]; then
                    printf '%s\n' "$provider_names" | grep -v '^$' || true
                else
                    printf 'NAME\n%s\n' "$provider_names"
                fi
                ;;
            create)
                provider_name=
                while [ "$#" -gt 0 ]; do
                    case $1 in
                        --name)
                            provider_name=${2:-}
                            shift
                            ;;
                    esac
                    shift
                done
                stub_record_provider "$provider_name"
                stub_record_credential
                printf 'stub: created provider %s\n' "$provider_name"
                ;;
            update)
                stub_record_provider "${1:-}"
                stub_record_credential
                printf 'stub: updated provider %s\n' "${1:-}"
                ;;
            *)
                printf 'stub: unsupported provider action: %s\n' "$action" >&2
                exit 1
                ;;
        esac
        ;;
    profile)
        action=${1:-}
        if [ "$#" -gt 0 ]; then
            shift
        fi
        case $action in
            lint)
                if [ "${STUB_PROFILE_LINT_EXIT:-0}" -ne 0 ]; then
                    printf 'stub: profile lint failed\n' >&2
                    exit "${STUB_PROFILE_LINT_EXIT}"
                fi
                printf 'Provider profile lint passed.\n'
                ;;
            import)
                profile_file=
                while [ "$#" -gt 0 ]; do
                    case $1 in
                        -f|--file)
                            profile_file=${2:-}
                            shift
                            ;;
                    esac
                    shift
                done
                if [ -n "$state" ] && [ -n "$profile_file" ] && [ -f "$profile_file" ]; then
                    profile_id=$(sed -n 's/^id:[[:space:]]*//p' "$profile_file" | head -n 1)
                    if [ -n "$profile_id" ]; then
                        mkdir -p "$state/profiles"
                        printf '%s\n' "$profile_id" >> "$state/profiles/imported"
                    fi
                fi
                printf 'Imported 1 provider profile.\n'
                ;;
            list)
                stub_output=table
                while [ "$#" -gt 0 ]; do
                    case $1 in
                        -o|--output)
                            stub_output=${2:-table}
                            shift
                            ;;
                        --output=*)
                            stub_output=${1#--output=}
                            ;;
                    esac
                    shift
                done
                stub_profiles=${STUB_PROFILE_NAMES:-}
                if [ -n "$state" ] && [ -f "$state/profiles/imported" ]; then
                    stub_profiles=$(printf '%s\n%s' "$stub_profiles" "$(cat "$state/profiles/imported")")
                fi
                if [ "$stub_output" = json ]; then
                    printf '['
                    stub_first=1
                    printf '%s\n' "$stub_profiles" | while IFS= read -r stub_profile; do
                        if [ -z "$stub_profile" ]; then
                            continue
                        fi
                        if [ "$stub_first" -eq 0 ]; then
                            printf ','
                        fi
                        stub_first=0
                        printf '\n  {"id": "%s", "type": "provider", "scope": "global"}' "$stub_profile"
                    done
                    printf '\n]\n'
                else
                    printf 'NAME\n%s\n' "$stub_profiles"
                fi
                ;;
            *)
                printf 'stub: unsupported profile action: %s\n' "$action" >&2
                exit 1
                ;;
        esac
        ;;
    policy)
        # argv already logged; STUB_POLICY_FULL lets a test seed the
        # effective policy text that `policy get --full` prints.
        if [ -n "${STUB_POLICY_FULL:-}" ]; then
            printf '%s\n' "$STUB_POLICY_FULL"
        else
            printf 'stub policy\n'
        fi
        ;;
    settings)
        # argv already logged; simulate a gateway that rejects the advisor
        # key so the fail-soft path is exercised.
        if [ "${STUB_SETTINGS_EXIT:-0}" -ne 0 ]; then
            printf 'stub: settings unsupported\n' >&2
            exit "${STUB_SETTINGS_EXIT}"
        fi
        printf 'stub: settings ok\n'
        ;;
    rule)
        if [ "${STUB_RULE_EXIT:-0}" -ne 0 ]; then
            printf 'stub: rule unavailable\n' >&2
            exit "${STUB_RULE_EXIT}"
        fi
        if [ -n "${STUB_RULE_PENDING:-}" ]; then
            printf '%s\n' "$STUB_RULE_PENDING"
        else
            printf 'Network Rules:  (version 1, 0 chunks)\n\n'
        fi
        ;;
    logs)
        printf 'stub log line\n'
        ;;
    version)
        printf 'openshell 0.1.2-stub\n'
        ;;
    *)
        printf 'stub: unsupported command: %s\n' "$command_name" >&2
        exit 1
        ;;
esac
