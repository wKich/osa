@env MAKI_OSS_WORKDIR
@env MAKI_OSS_WORKSPACE
@env MAKI_VERSION
---
sandbox
exec
-n
maki-myproject
--no-login-shell
--workdir
<case>/sandbox/project
--
sh
-c
set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
if ! git rev-parse -q --verify refs/maki-oss/base >/dev/null 2>&1; then
    printf "missing\n"
    exit 0
fi
index=$gitdir/tree-index.$$
rm -f "$index"
if ! GIT_INDEX_FILE=$index git add -A 2>/dev/null; then
    rm -f "$index"
    printf "missing\n"
    exit 0
fi
tree=$(GIT_INDEX_FILE=$index git write-tree)
rm -f "$index"
printf "%s\n" "$tree"
maki-oss-git
<case>/sandbox/.maki-oss/git
<case>/sandbox/project
@env MAKI_OSS_IDLE_STOP
@env MAKI_OSS_IMAGE
@env MAKI_OSS_INTERACTIVE
@env MAKI_OSS_POLICY
@env MAKI_OSS_PROVIDERS
@env MAKI_OSS_RUN_TAG
@env MAKI_OSS_SANDBOX_NAME
@env MAKI_OSS_TEST_ENV_VALUE
@env MAKI_OSS_TIMEOUT
@env MAKI_OSS_TUI
@env MAKI_OSS_WORKDIR
@env MAKI_OSS_WORKSPACE
@env MAKI_VERSION
---
sandbox
provider
list
maki-myproject
--output
json
---
stub-bun start
stub-bun argv: <repo>/bridge/src/bridge.ts
stub-bun env: OPENMAKI_SANDBOX=maki-myproject OPENMAKI_CWD=<case>/sandbox/project MAKI_MODEL= OPENSHELL_BIN=<repo>/tests/stub/openshell PORT=
---
stub-opencode
stub-opencode argv: --server
stub-opencode argv: http://127.0.0.1:4698
stub-bun SIGTERM
---
rule
get
maki-myproject
--status
pending
@env MAKI_OSS_IDLE_STOP
@env MAKI_OSS_IMAGE
@env MAKI_OSS_INTERACTIVE
@env MAKI_OSS_POLICY
@env MAKI_OSS_PROVIDERS
@env MAKI_OSS_RUN_TAG
