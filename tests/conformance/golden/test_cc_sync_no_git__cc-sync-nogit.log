sandbox
exec
-n
cc-myproject
--no-login-shell
--workdir
<case>/sandbox/project
--
sh
-c
set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
export GIT_AUTHOR_NAME=claude-oss GIT_AUTHOR_EMAIL=claude-oss@localhost
export GIT_COMMITTER_NAME=claude-oss GIT_COMMITTER_EMAIL=claude-oss@localhost
mkdir -p "$gitdir" "$worktree"
git init -q
git add -A
tree=$(git write-tree)
commit=$(git commit-tree "$tree" -m "claude-oss baseline")
git update-ref refs/claude-oss/base "$commit"
printf "%s\n" "$tree"
claude-oss-git
<case>/sandbox/.claude-oss/git
<case>/sandbox/project
