#!/usr/bin/env bun
// Stub osa CLI for the dashboard test suite.
//
// Answers `status PATH --quick --json` and `status PATH --json` from a JSON
// fixture keyed by host path, `health SANDBOX --json` from its `health` key
// (else the built-in HEALTH_FIXTURES below), and `resolve SANDBOX ACTION
// --json [--yes]` from its `resolve` key, by sandbox and action:
//
//   {
//     "/abs/path": { "quick": [ ...entries ], "full": [ ...entries ] },
//     "health": {
//       "SANDBOX": {
//         "report": { ... },    // the health object printed (default: built in)
//         "exit": 0,            // exit code (default 0)
//         "stderr": "...",      // written to stderr
//         "delay": 0.5          // seconds to wait before answering
//       }
//     },
//     "resolve": {
//       "SANDBOX": {
//         "ACTION": {
//           "exit": 0,            // 0 done, 2 refused, 3 failed (default 0)
//           "changed": [ ... ],   // the result object's `changed` (default [])
//           "message": "...",     // the result object's `message`
//           "stderr": "...",      // written to stderr
//           "raw": "...",         // printed instead of the result object
//           "delay": 0.5,         // seconds to wait before answering
//           "remove": [ ... ]     // files deleted on exit 0, like a cleared marker
//         }
//       }
//     }
//   }
//
// `images --json` answers from the fixture's `images` array, else the built-in
// IMAGE_FIXTURES (present, missing, error with markup, configured); a tag the
// stub built since is reported present. `image build TAG` follows the
// fixture's `build` key, by tag or `default`:
//
//   "build": { "mk": { "mode": "lines", "lines": 3, "interval": 0.05,
//                      "exit": 0, "text": "Step" } }
//
//   mode lines        prints `lines` lines (default 3) every `interval` s
//                     (default 0.05), alternating stdout and stderr, then
//                     exits `exit` (default 0); exit 0 marks the tag built
//   mode sleep        prints one line, then waits until SIGTERM (exit 143)
//   mode ignore-term  prints one line and ignores SIGTERM (only SIGKILL ends it)
//
// `providers --json` answers from the fixture's `providers` array, else the
// built-in PROVIDER_FIXTURES (a stdin agent with curated and custom profiles,
// a note with markup, a gateway error, and a login agent); a provider the
// stub created since is added to its agent's gateway list. `provider setup
// TAG --profile ID [--name N] [--attach S] [--yes] --json` reads stdin to EOF,
// appends `{"argv": [...], "bytes": N}` to STUB_OSA_STDIN_LOG (the byte
// count, never the value), and follows the fixture's `setup` key, by profile
// or `default`:
//
//   "setup": { "maki-deepseek": { "mode": "created", "delay": 0.5 } }
//
//   mode created (default), updated (default with --yes), refused (exit 2),
//   failed (exit 3 after create, attach failed), usage (exit 1), slow (sleeps
//   `delay` s, default 30, then created), echo-secret (created, with the
//   received credential in the message and on stderr)
//
// A path missing from the fixture (or a missing mode) answers `[]`, like osa
// for an unregistered path; a quick entry reports `busy` and `idle` as the
// fixture gives them, and `idle` is `{"state": "none", ...}` when it gives
// none. A health request for a sandbox with no answer is a usage error
// (exit 1), like osa for an unregistered sandbox. A resolve with no answer
// is refused with exit 2. Every other command is a usage error.
//
// Environment knobs:
//   STUB_OSA_FIXTURE  JSON fixture file (default: none, every answer is [])
//   STUB_OSA_LOG      file to append each argv to, one JSON array per line
//   STUB_OSA_FAIL     "exit": exit 1 with a message on stderr
//                     "hang": never answer (until killed)
//                     "invalid-json": exit 0 with non-JSON output
//   STUB_OSA_DELAY    seconds to wait before answering
//   STUB_OSA_STDIN_LOG  file receiving each provider setup's argv and stdin
//                     byte count, one JSON object per line
//   STUB_OSA_STATE    directory for built tags and created providers
//                     (default: next to STUB_OSA_FIXTURE)

import { appendFileSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";

const args = process.argv.slice(2);
const env = process.env;

if (env.STUB_OSA_LOG) appendFileSync(env.STUB_OSA_LOG, `${JSON.stringify(args)}\n`);

switch (env.STUB_OSA_FAIL) {
  case "exit":
    process.stderr.write("stub osa: forced failure\n");
    process.exit(1);
  case "hang":
    setInterval(() => {}, 1000);
    await new Promise(() => {});
  case "invalid-json":
    process.stdout.write("this is not valid json\n");
    process.exit(0);
}

/** An idle section; `state` and `deadline` vary, the rest is filled in. */
function idle(state: string, deadline: string | null = null, period: number | null = 3600) {
  return { period, state, deadline, estimated: false, last_event: null, last_time: null };
}

