---
sandbox
exec
-n
maki-repo
--no-login-shell
--workdir
<case>/sandbox/project
--
sh
-c
set -e
worktree=$2
manifest=$3
while IFS= read -r path; do
    case $path in
        ""|/*|..|../*|*/..|*/../*) continue ;;
    esac
    target=$worktree/$path
    if [ -f "$target" ] || [ -L "$target" ]; then
        rm -f -- "$target"
    fi
done < "$manifest"
rm -f -- "$manifest"
maki-oss-git
<case>/sandbox/.maki-oss/git
<case>/sandbox/project
<case>/sandbox/maki-oss-prune.<pid>
@env MAKI_OSS_IDLE_STOP
@env MAKI_OSS_IMAGE
@env MAKI_OSS_INTERACTIVE
@env MAKI_OSS_POLICY
