@env MAKI_OSS_WORKSPACE
@env MAKI_VERSION
@client
provider list --names
sandbox get maki-myproject --output json
sandbox get maki-myproject --output json
sandbox get maki-myproject --output json
sandbox provider list maki-myproject --output json
provider list --names
