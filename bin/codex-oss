#!/bin/sh
# codex-oss: front door for the Codex sandbox helper.
#
# The command logic is the Rust binary built from osa-core/. This shim only
# resolves it:
#   OSA_BACKEND_CODEX   command path or argv prefix (the test harness)
#   OSA_FRONTEND_BIN    a built binary path
# Unset uses the checkout's release build. `exec` replaces this process, so
# signals, TTY state, and the exit status belong to the binary.
set -eu

script=$0
case $script in
    */*) ;;
    *) script=$(command -v -- "$script" 2>/dev/null || printf '%s' "$script") ;;
esac
script_dir=$(CDPATH='' cd -- "$(dirname -- "$script")" && pwd -P)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd -P)
self=$script_dir/${script##*/}

backend=${OSA_BACKEND_CODEX:-}
if [ "$backend" = "$self" ]; then
    backend=
fi
if [ -z "$backend" ]; then
    backend=${OSA_FRONTEND_BIN:-$repo_root/osa-core/target/release/codex-oss}
fi

case $backend in
    *" "*|*"	"*) ;;
    *)
        if ! command -v -- "$backend" >/dev/null 2>&1; then
            printf '%s: the front-end binary is missing; run make build in %s (looked for %s)\n' \
                'codex-oss' "$repo_root" "$backend" >&2
            exit 1
        fi
        ;;
esac

OSA_REPO_ROOT=$repo_root
export OSA_REPO_ROOT
# Word splitting is intentional: the harness accepts an argv prefix.
exec $backend "$@"
