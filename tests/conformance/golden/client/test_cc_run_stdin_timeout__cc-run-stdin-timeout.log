sandbox
exec
-n
cc-myproject
--no-login-shell
--workdir
<case>/sandbox/project
--
sh
-c
set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
if ! git rev-parse -q --verify refs/claude-oss/base >/dev/null 2>&1; then
    printf "missing\n"
    exit 0
fi
index=$gitdir/tree-index.$$
rm -f "$index"
if ! GIT_INDEX_FILE=$index git add -A 2>/dev/null; then
    rm -f "$index"
    printf "missing\n"
    exit 0
fi
tree=$(GIT_INDEX_FILE=$index git write-tree)
rm -f "$index"
printf "%s\n" "$tree"
claude-oss-git
<case>/sandbox/.claude-oss/git
<case>/sandbox/project
@env CLAUDE_OSS_IDLE_STOP
@env CLAUDE_OSS_IMAGE
@env CLAUDE_OSS_INTERACTIVE
@env CLAUDE_OSS_MODEL
@env CLAUDE_OSS_RUN_TAG
@env CLAUDE_OSS_SANDBOX_NAME
@env CLAUDE_OSS_TIMEOUT
@env CLAUDE_OSS_WORKDIR
@env MAKI_OSS_IDLE_STOP
@env MAKI_OSS_IMAGE
@env MAKI_OSS_INTERACTIVE
@env MAKI_OSS_POLICY
