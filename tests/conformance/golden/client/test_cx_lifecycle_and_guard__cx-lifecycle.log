@transport client
@client
sandbox get cx-myproject --output json
sandbox create --name cx-myproject --from codex-agent:local --policy <parsed> --env CODEX_CHATGPT_TOKEN=x --detach
sandbox get cx-myproject --output json
sandbox get cx-myproject --output json
sandbox get cx-myproject --output json
sandbox provider list cx-myproject --output json
sandbox get cx-myproject --output json
sandbox exec -n cx-myproject --no-login-shell --workdir <case>/sandbox/project -- sh -c set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
if ! git rev-parse -q --verify refs/codex-oss/base >/dev/null 2>&1; then
    printf "missing\n"
    exit 0
fi
index=$gitdir/tree-index.$$
rm -f "$index"
if ! GIT_INDEX_FILE=$index git add -A 2>/dev/null; then
    rm -f "$index"
    printf "missing\n"
    exit 0
fi
tree=$(GIT_INDEX_FILE=$index git write-tree)
rm -f "$index"
printf "%s\n" "$tree" codex-oss-git <case>/sandbox/.codex-oss/git <case>/sandbox/project
sandbox exec -n cx-myproject --no-login-shell --workdir <case>/sandbox/project -- sh -c set -e
worktree=$2
if [ -n "$(find "$worktree" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
    printf "nonempty\n"
else
    printf "empty\n"
fi codex-oss-git <case>/sandbox/.codex-oss/git <case>/sandbox/project
sandbox get cx-myproject --output json
sandbox get cx-myproject --output json
sandbox delete cx-myproject
