#!/bin/sh
# shellcheck shell=sh source-path=SCRIPTDIR
#
# osa: report on every project the agent front-ends (maki-oss, opencode-oss,
# claude-oss, codex-oss) have registered in the shared state root.
#
# `projects`, `status`, `health`, `providers`, and `images` are read-only:
# they never create, start, stop, delete, upload to, or download from a
# sandbox, launch an agent, change a provider, build an image, or write the
# state root. They read the published contract files (registry entries and
# pending markers) and ask the front-ends, which run only their read-only
# status, `mcp status`, `doctor`, provider list, and image inspect probes.
# Three commands change things, each validated here and handed to the
# front-end: `resolve` (its `__resolve`), `provider setup` (its
# `__provider-setup`, with stdin passed through unread), and `image build`
# (its `image build`, which changes only the local base image tag).
#
# POSIX sh. See docs/helper.md for the full reference.

set -eu

PROGRAM=osa
EX_USAGE=1

script=$0
case $script in
    */*) ;;
    *) script=$(command -v -- "$script" 2>/dev/null || printf '%s' "$script") ;;
esac
script_dir=$(CDPATH='' cd -- "$(dirname -- "$script")" && pwd -P)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd -P)

# shellcheck source=../lib/osa-state.sh
. "$repo_root/lib/osa-state.sh"

usage() {
    cat <<'EOF'
osa: report on the projects the agent front-ends have registered.

Usage:
  osa <command> [options]

Commands:
  projects [--json]                 List every registered project
  status [PATH] [--json] [--quick]  Report the project at PATH (default: .)
                                    for each agent registered there
  health SANDBOX [--json]           Report the sandbox's idle stop, MCP
                                    readiness, and doctor checks
  providers [--agent TAG] [--json]  List each agent's setup profiles, the
                                    gateway's providers, and the remembered
                                    providers
  images [--json]                   Report each agent's base image tag and
                                    whether it exists locally
  resolve SANDBOX ACTION [--yes] [--json]
                                    Resolve the sandbox's pending work:
                                    apply, branch, or drop --yes for a
                                    retained patch; rescue or discard --yes
                                    for a parked workspace
  provider setup TAG --profile ID [--name NAME] [--attach SANDBOX] [--yes] [--json]
                                    Set up a provider for agent TAG from a
                                    credential read on stdin, never prompted
  image build TAG                   Build agent TAG's base image
  help                              Show this help

Agent tags: mk (maki-oss), oc (opencode-oss), cc (claude-oss), cx (codex-oss).

Options:
  --json    Print one JSON array (health, resolve, and provider setup: one
            JSON object) on stdout and nothing else
  --quick   Skip the gateway and the tree hash: report the pending kind,
            whether the host changed since the last sync (changed,
            unchanged, or unknown), whether a session or resolve is
            running (busy), and the idle-stop state and deadline (idle)
  --yes     Confirm drop or discard; for provider setup, update an
            existing provider's credential

Only resolve, provider setup, and image build change anything. Exit codes
for resolve and provider setup: 0 done, 1 usage error, 2 refused before any
change, 3 failed during the action. image build exits 0 when the image was
built, 1 for a usage error, and the front-end's status otherwise.
EOF
}

die_usage() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    printf "Run '%s help' for usage.\n" "$PROGRAM" >&2
    exit "$EX_USAGE"
}

# Prints the front-end that owns an agent tag.
front_end() { # TAG
    case $1 in
        mk) printf '%s/bin/maki-oss' "$repo_root" ;;
        oc) printf '%s/bin/opencode-oss' "$repo_root" ;;
        cc) printf '%s/bin/claude-oss' "$repo_root" ;;
        cx) printf '%s/bin/codex-oss' "$repo_root" ;;
    esac
}

AGENT_TAGS='mk oc cc cx'

# Succeeds for a lowercase kebab-case word (profile ids, provider names).
valid_kebab() { # WORD
    case $1 in
        ''|*[!a-z0-9-]*|-*|*--*|*-) return 1 ;;
    esac
    return 0
}

# Prints PATH as an absolute physical path, or as an absolute literal path
# when it no longer exists (an orphan's folder).
absolute_path() { # PATH
    if ap_dir=$(CDPATH='' cd -- "$1" 2>/dev/null && pwd -P); then
        printf '%s' "$ap_dir"
        return 0
    fi
    case $1 in
        /*) printf '%s' "$1" ;;
        *) printf '%s/%s' "$(pwd -P)" "$1" ;;
    esac
}

# Prints the registry entries, one file path per line.
registry_entries() {
    [ -d "$registry_dir" ] || return 0
    for re_file in "$registry_dir"/*.toml; do
        [ -f "$re_file" ] && printf '%s\n' "$re_file"
    done
    return 0
}

# Loads one registry entry into the e_* variables.
load_entry() { # FILE
    e_agent=$(flat_value "$1" agent)
    e_host_path=$(flat_value "$1" host_path)
    e_project=$(flat_value "$1" project)
    e_sandbox_name=$(flat_value "$1" sandbox_name)
    e_sandbox_id=$(flat_value "$1" sandbox_id)
    e_created=$(flat_value "$1" created)
    e_last_session=$(flat_value "$1" last_session)
    e_fingerprint=$(flat_value "$1" fingerprint)
    e_version=$(flat_value "$1" version)
    e_pending=$(pending_kind "$state_root/sessions/$e_sandbox_name")
    e_orphan=false
    if [ ! -d "$e_host_path" ]; then
        e_orphan=true
    fi
}

entry_json_fields() {
    printf '"version":%s,"agent":%s,"host_path":%s,"project":%s,"sandbox_name":%s,"sandbox_id":%s,"created":%s,"last_session":%s,"fingerprint":%s,"pending":%s,"orphan":%s' \
        "$(json_str "$e_version")" "$(json_str "$e_agent")" "$(json_str "$e_host_path")" \
        "$(json_str "$e_project")" "$(json_str "$e_sandbox_name")" "$(json_str "$e_sandbox_id")" \
        "$(json_str "$e_created")" "$(json_str "$e_last_session")" "$(json_str "$e_fingerprint")" \
        "$(json_str "$e_pending")" "$e_orphan"
}

# Prints `true` while a live session or resolve holds the loaded entry's
# sandbox lock, else `false`. Read-only: stale lock files are left alone.
entry_busy() {
    if lock_busy "$state_root/sessions/$e_sandbox_name/locks"; then
        printf 'true'
    else
        printf 'false'
    fi
}

cmd_projects() {
    if [ "$opt_json" -eq 1 ]; then
        cp_sep=
        printf '['
        while IFS= read -r cp_file; do
            [ -n "$cp_file" ] || continue
            load_entry "$cp_file"
            printf '%s{' "$cp_sep"
            entry_json_fields
            printf '}'
            cp_sep=,
        done <<ENTRIES
$(registry_entries)
ENTRIES
        printf ']\n'
        return 0
    fi
    cp_count=0
    while IFS= read -r cp_file; do
        [ -n "$cp_file" ] || continue
        load_entry "$cp_file"
        if [ "$cp_count" -eq 0 ]; then
            printf '%-5s %-19s %-8s %-12s %s\n' AGENT SANDBOX PENDING PROJECT PATH
        fi
        cp_path=$e_host_path
        if [ "$e_orphan" = true ]; then
            cp_path="$cp_path (orphan: folder missing)"
        fi
        printf '%-5s %-19s %-8s %-12s %s\n' "$e_agent" "$e_sandbox_name" \
            "${e_pending:--}" "$e_project" "$cp_path"
        cp_count=$((cp_count + 1))
    done <<ENTRIES
$(registry_entries)
ENTRIES
    if [ "$cp_count" -eq 0 ]; then
        printf 'No registered projects. Run maki-oss, opencode-oss, claude-oss, or codex-oss in a project.\n'
    fi
}

# Prints `changed`, `unchanged`, or `unknown` for the loaded entry.
fingerprint_result() {
    if [ -z "$e_fingerprint" ] || [ "$e_orphan" = true ]; then
        printf 'unknown'
        return 0
    fi
    fr_now=$(project_fingerprint "$e_host_path")
    if [ -z "$fr_now" ]; then
        printf 'unknown'
    elif [ "$fr_now" = "$e_fingerprint" ]; then
        printf 'unchanged'
    else
        printf 'changed'
    fi
}

cmd_status() {
    cs_path=$(absolute_path "${opt_path:-.}")
    cs_sep=
    cs_count=0
    if [ "$opt_json" -eq 1 ]; then
        printf '['
    fi
    while IFS= read -r cs_file; do
        [ -n "$cs_file" ] || continue
        [ "$(flat_value "$cs_file" host_path)" = "$cs_path" ] || continue
        load_entry "$cs_file"
        cs_count=$((cs_count + 1))
        if [ "$opt_quick" -eq 1 ]; then
            cs_fp=$(fingerprint_result)
            cs_busy=$(entry_busy)
            if [ "$opt_json" -eq 1 ]; then
                printf '%s{' "$cs_sep"
                entry_json_fields
                printf ',"fingerprint_result":%s,"busy":%s,"idle":%s}' "$(json_str "$cs_fp")" \
                    "$cs_busy" "$(idle_json "$state_root/sessions/$e_sandbox_name")"
            else
                printf 'Sandbox:   %s (%s)\n' "$e_sandbox_name" "$e_agent"
                printf 'Pending:   %s\n' "${e_pending:-none}"
                printf 'Host:      %s since the last sync\n' "$cs_fp"
                if [ "$cs_busy" = true ]; then
                    printf 'Busy:      a session or resolve is running\n'
                fi
                printf 'Idle stop: %s\n' "$(idle_text "$state_root/sessions/$e_sandbox_name")"
            fi
        else
            cs_front=$(front_end "$e_agent")
            [ -n "$cs_front" ] || continue
            if [ "$e_orphan" = true ]; then
                if [ "$opt_json" -eq 1 ]; then
                    printf '%s{' "$cs_sep"
                    entry_json_fields
                    printf '}'
                else
                    printf 'Sandbox:   %s (%s): folder missing\n' "$e_sandbox_name" "$e_agent"
                fi
            elif [ "$opt_json" -eq 1 ]; then
                printf '%s{' "$cs_sep"
                entry_json_fields
                cs_full=$(cd "$e_host_path" && "$cs_front" --name "$e_sandbox_name" __status-json) \
                    || cs_full='{}'
                printf ',"status":%s}' "$cs_full"
            else
                (cd "$e_host_path" && "$cs_front" --name "$e_sandbox_name" status) || :
            fi
        fi
        cs_sep=,
    done <<ENTRIES
$(registry_entries)
ENTRIES
    if [ "$opt_json" -eq 1 ]; then
        printf ']\n'
    elif [ "$cs_count" -eq 0 ]; then
        printf 'No project is registered at %s.\n' "$cs_path"
    fi
}

EX_REFUSED=2

# Refuses a resolve before anything changed: exit 2, with the result object on
# stdout under --json.
resolve_refuse() { # MESSAGE
    if [ "$opt_json" -eq 1 ]; then
        printf '{"sandbox":%s,"action":%s,"ok":false,"changed":[],"message":%s}\n' \
            "$(json_str "$opt_sandbox")" "$(json_str "$opt_action")" "$(json_str "$1")"
    fi
    printf '%s: %s\n' "$PROGRAM" "$1" >&2
    exit "$EX_REFUSED"
}

# Prints the registry entry file for SANDBOX, found by file name, never by
# joining the argument into a path; nothing when it is not registered.
entry_file() { # SANDBOX
    while IFS= read -r ef_entry; do
        [ -n "$ef_entry" ] || continue
        if [ "${ef_entry##*/}" = "$1.toml" ]; then
            printf '%s' "$ef_entry"
            return 0
        fi
    done <<ENTRIES
$(registry_entries)
ENTRIES
}

# Reports one registered sandbox's health. The owning front-end runs it in the
# project folder (`__health-json`, or `__health` for text); an orphan, or an
# agent osa does not know, gets the idle section from files only.
cmd_health() {
    ch_file=$(entry_file "$opt_sandbox")
    if [ -z "$ch_file" ]; then
        die_usage "sandbox '$opt_sandbox' is not registered; run 'osa projects' to list sandboxes"
    fi
    load_entry "$ch_file"
    if [ "$e_sandbox_name" != "$opt_sandbox" ]; then
        die_usage "the registry entry $ch_file names sandbox '$e_sandbox_name', not '$opt_sandbox'"
    fi
    ch_front=$(front_end "$e_agent")
    ch_error=
    if [ "$e_orphan" = true ]; then
        ch_error="project folder missing"
    elif [ -z "$ch_front" ]; then
        ch_error="agent '$e_agent' is not known to osa"
    fi
    if [ -z "$ch_error" ]; then
        ch_verb=__health
        if [ "$opt_json" -eq 1 ]; then
            ch_verb=__health-json
        fi
        ch_rc=0
        (cd "$e_host_path" && exec "$ch_front" --name "$opt_sandbox" "$ch_verb") || ch_rc=$?
        exit "$ch_rc"
    fi
    ch_dir=$state_root/sessions/$opt_sandbox
    if [ "$opt_json" -eq 1 ]; then
        printf '{"sandbox":%s,"agent":%s,"idle":%s,"mcp":{"error":%s},"doctor":{"error":%s}}\n' \
            "$(json_str "$opt_sandbox")" "$(json_str "$e_agent")" "$(idle_json "$ch_dir")" \
            "$(json_str "$ch_error")" "$(json_str "$ch_error")"
        return 0
    fi
    printf "Health of sandbox '%s' (%s):\n" "$opt_sandbox" "$e_agent"
    printf 'Idle stop: %s\n' "$(idle_text "$ch_dir")"
    printf '\nMCP readiness:\n  error: %s\n\nDoctor:\n  error: %s\n' "$ch_error" "$ch_error"
}

# Refuses an unregistered or orphan entry and runs the owning front-end's
# `__resolve` in the project folder.
cmd_resolve() {
    cr_file=$(entry_file "$opt_sandbox")
    if [ -z "$cr_file" ]; then
        resolve_refuse "sandbox '$opt_sandbox' is not registered; run 'osa projects' to list sandboxes"
    fi
    load_entry "$cr_file"
    if [ "$e_sandbox_name" != "$opt_sandbox" ]; then
        resolve_refuse "the registry entry $cr_file names sandbox '$e_sandbox_name', not '$opt_sandbox'"
    fi
    if [ "$e_orphan" = true ]; then
        resolve_refuse "the project folder for '$opt_sandbox' is missing: $e_host_path"
    fi
    cr_front=$(front_end "$e_agent")
    if [ -z "$cr_front" ]; then
        resolve_refuse "sandbox '$opt_sandbox' belongs to agent '$e_agent', which osa does not know"
    fi
    set -- --name "$opt_sandbox" __resolve "$opt_action"
    if [ "$opt_yes" -eq 1 ]; then
        set -- "$@" --yes
    fi
    if [ "$opt_json" -eq 1 ]; then
        set -- "$@" --json
    fi
    cr_rc=0
    (cd "$e_host_path" && exec "$cr_front" "$@") || cr_rc=$?
    exit "$cr_rc"
}

# Prints one object per agent (or only --agent): the owning front-end's
# `__providers-json`, or an error object when it fails.
cmd_providers() {
    cp_tags=${opt_agent:-$AGENT_TAGS}
    cp_sep=
    if [ "$opt_json" -eq 1 ]; then
        printf '['
    fi
    for cp_tag in $cp_tags; do
        cp_front=$(front_end "$cp_tag")
        if [ "$opt_json" -eq 0 ]; then
            printf '%s' "$cp_sep"
            "$cp_front" __providers </dev/null || printf '%s: provider report failed\n' "$cp_tag"
            cp_sep=$NL
            continue
        fi
        cp_json=$("$cp_front" __providers-json </dev/null) || cp_json=
        if [ -z "$cp_json" ]; then
            cp_json=$(printf '{"agent":%s,"error":{"message":%s}}' "$(json_str "$cp_tag")" \
                "$(json_str "${cp_front##*/} __providers-json failed")")
        fi
        printf '%s%s' "$cp_sep" "$cp_json"
        cp_sep=,
    done
    if [ "$opt_json" -eq 1 ]; then
        printf ']\n'
    fi
}

# Validates the tag, profile id, name, and attach sandbox, asks the front-end
# whether it can set up from stdin (the probe reads no stdin), and then execs
# its `__provider-setup` so stdin reaches it untouched: osa never reads it.
cmd_provider_setup() {
    ps_front=$(front_end "$opt_agent")
    if [ -n "$opt_attach" ]; then
        ps_file=$(entry_file "$opt_attach")
        if [ -z "$ps_file" ]; then
            die_usage "sandbox '$opt_attach' is not registered; run 'osa projects' to list sandboxes"
        fi
        ps_agent=$(flat_value "$ps_file" agent)
        if [ "$(flat_value "$ps_file" sandbox_name)" != "$opt_attach" ]; then
            die_usage "the registry entry $ps_file does not name sandbox '$opt_attach'"
        fi
        if [ "$ps_agent" != "$opt_agent" ]; then
            die_usage "sandbox '$opt_attach' belongs to agent '$ps_agent', not '$opt_agent'"
        fi
    fi
    ps_rc=0
    if [ "$opt_json" -eq 1 ]; then
        "$ps_front" __provider-setup --probe --json </dev/null || ps_rc=$?
    else
        "$ps_front" __provider-setup --probe </dev/null || ps_rc=$?
    fi
    if [ "$ps_rc" -ne 0 ]; then
        exit "$ps_rc"
    fi
    set --
    if [ -n "$opt_attach" ]; then
        set -- --name "$opt_attach"
    fi
    set -- "$@" __provider-setup --profile "$opt_profile"
    if [ -n "$opt_name" ]; then
        set -- "$@" --provider-name "$opt_name"
    fi
    if [ -n "$opt_attach" ]; then
        set -- "$@" --attach
    fi
    if [ "$opt_yes" -eq 1 ]; then
        set -- "$@" --yes
    fi
    if [ "$opt_json" -eq 1 ]; then
        set -- "$@" --json
    fi
    exec "$ps_front" "$@"
}

# Prints one line (or object) per agent from the front-end's image report.
# No gateway call and no build.
cmd_images() {
    ci_sep=
    if [ "$opt_json" -eq 1 ]; then
        printf '['
    fi
    for ci_tag in $AGENT_TAGS; do
        ci_front=$(front_end "$ci_tag")
        if [ "$opt_json" -eq 0 ]; then
            "$ci_front" __image </dev/null || printf '%s: image report failed\n' "$ci_tag"
            continue
        fi
        ci_json=$("$ci_front" __image-json </dev/null) || ci_json=
        if [ -z "$ci_json" ]; then
            ci_json=$(printf '{"agent":%s,"error":{"message":%s}}' "$(json_str "$ci_tag")" \
                "$(json_str "${ci_front##*/} __image-json failed")")
        fi
        printf '%s%s' "$ci_sep" "$ci_json"
        ci_sep=,
    done
    if [ "$opt_json" -eq 1 ]; then
        printf ']\n'
    fi
}

# Hands off to the front-end's `image build` with its default tag and version:
# exec keeps one PID to signal, and stdin is closed.
cmd_image_build() {
    exec "$(front_end "$opt_agent")" image build </dev/null
}

osa_state_paths

NL='
'

opt_json=0
opt_yes=0
opt_sandbox=
opt_action=
opt_quick=0
opt_path=
opt_agent=
opt_profile=
opt_name=
opt_attach=

COMMANDS='projects, status, health, providers, images, resolve, provider setup, image build, help'

[ "$#" -gt 0 ] || { usage; exit 0; }
cmd=$1
shift
case $cmd in
    help|-h|--help)
        usage
        exit 0
        ;;
    projects|status|health|providers|images|resolve) ;;
    provider|image)
        case ${1:-} in
            setup) [ "$cmd" = provider ] || die_usage "unknown command: $cmd ${1:-} (commands: $COMMANDS)" ;;
            build) [ "$cmd" = image ] || die_usage "unknown command: $cmd ${1:-} (commands: $COMMANDS)" ;;
            *) die_usage "unknown command: $cmd${1:+ $1} (commands: $COMMANDS)" ;;
        esac
        cmd="$cmd-$1"
        shift
        ;;
    *)
        die_usage "unknown command: $cmd (commands: $COMMANDS)"
        ;;
esac

# image build takes exactly one TAG and nothing else: no version or tag
# override reaches the front-end.
if [ "$cmd" = image-build ]; then
    [ "$#" -eq 1 ] || die_usage "usage: osa image build TAG (no other argument)"
    case $1 in
        mk|oc|cc|cx) ;;
        *) die_usage "unknown agent tag: $1 (tags: mk, oc, cc, cx)" ;;
    esac
    opt_agent=$1
    cmd_image_build
fi

while [ "$#" -gt 0 ]; do
    case $1 in
        --json) opt_json=1 ;;
        --quick)
            [ "$cmd" = status ] || die_usage "--quick applies to status only"
            opt_quick=1
            ;;
        --yes)
            [ "$cmd" = resolve ] || [ "$cmd" = provider-setup ] \
                || die_usage "--yes applies to resolve and provider setup only"
            opt_yes=1
            ;;
        --agent)
            [ "$cmd" = providers ] || die_usage "--agent applies to providers only"
            [ "$#" -gt 1 ] || die_usage "option --agent requires a value"
            opt_agent=$2
            shift
            ;;
        --profile|--name|--attach)
            [ "$cmd" = provider-setup ] || die_usage "$1 applies to provider setup only"
            [ "$#" -gt 1 ] || die_usage "option $1 requires a value"
            case $1 in
                --profile) opt_profile=$2 ;;
                --name) opt_name=$2 ;;
                --attach) opt_attach=$2 ;;
            esac
            shift
            ;;
        -*) die_usage "unknown option: $1" ;;
        *)
            if [ "$cmd" = health ]; then
                [ -z "$opt_sandbox" ] || die_usage "health takes one SANDBOX"
                opt_sandbox=$1
                shift
                continue
            fi
            if [ "$cmd" = resolve ]; then
                if [ -z "$opt_sandbox" ]; then
                    opt_sandbox=$1
                elif [ -z "$opt_action" ]; then
                    opt_action=$1
                else
                    die_usage "resolve takes SANDBOX and ACTION"
                fi
                shift
                continue
            fi
            if [ "$cmd" = provider-setup ]; then
                [ -z "$opt_agent" ] || die_usage "provider setup takes one TAG"
                opt_agent=$1
                shift
                continue
            fi
            [ "$cmd" = status ] || die_usage "$cmd takes no arguments"
            [ -z "$opt_path" ] || die_usage "status takes at most one PATH"
            opt_path=$1
            ;;
    esac
    shift
done

if [ "$cmd" = health ]; then
    [ -n "$opt_sandbox" ] || die_usage "usage: osa health SANDBOX [--json]"
fi

if [ "$cmd" = resolve ]; then
    [ -n "$opt_action" ] || die_usage "usage: osa resolve SANDBOX ACTION [--yes] [--json]"
    case $opt_action in
        apply|branch|drop|rescue|discard) ;;
        *) die_usage "unknown resolve action: $opt_action (actions: apply, branch, drop, rescue, discard)" ;;
    esac
fi

if [ "$cmd" = providers ] && [ -n "$opt_agent" ]; then
    case $opt_agent in
        mk|oc|cc|cx) ;;
        *) die_usage "unknown agent tag: $opt_agent (tags: mk, oc, cc, cx)" ;;
    esac
fi

if [ "$cmd" = provider-setup ]; then
    [ -n "$opt_agent" ] || die_usage "usage: osa provider setup TAG --profile ID [--name NAME] [--attach SANDBOX] [--yes] [--json]"
    case $opt_agent in
        mk|oc|cc|cx) ;;
        *) die_usage "unknown agent tag: $opt_agent (tags: mk, oc, cc, cx)" ;;
    esac
    [ -n "$opt_profile" ] || die_usage "provider setup needs --profile ID"
    valid_kebab "$opt_profile" || die_usage "invalid profile id '$opt_profile': use kebab-case"
    if [ -n "$opt_name" ]; then
        valid_kebab "$opt_name" || die_usage "invalid provider name '$opt_name': use kebab-case"
    fi
fi

case $cmd in
    projects) cmd_projects ;;
    status) cmd_status ;;
    health) cmd_health ;;
    providers) cmd_providers ;;
    images) cmd_images ;;
    resolve) cmd_resolve ;;
    provider-setup) cmd_provider_setup ;;
esac
