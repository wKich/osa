#!/bin/sh
# osa: launch the Rust core. See docs/helper.md for the command reference.
#
# The core binary is built from osa-core/; `make build` prints its path. This
# shim holds no command logic: signals, TTY state, and the exit status belong
# to the binary because `exec` replaces this process.
set -eu

script=$0
case $script in
    */*) ;;
    *) script=$(command -v -- "$script" 2>/dev/null || printf '%s' "$script") ;;
esac
script_dir=$(CDPATH='' cd -- "$(dirname -- "$script")" && pwd -P)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd -P)

# The launcher variable lets a test or a second build run without reinstalling.
if [ -n "${OSA_CORE_BIN:-}" ]; then
    OSA_REPO_ROOT=$repo_root
    export OSA_REPO_ROOT
    exec "$OSA_CORE_BIN" "$@"
fi

core=$repo_root/osa-core/target/release/osa
if [ -x "$core" ]; then
    OSA_REPO_ROOT=$repo_root
    export OSA_REPO_ROOT
    exec "$core" "$@"
fi

printf 'osa: the core binary is missing; run make build in %s (looked for %s)\n' \
    "$repo_root" "$core" >&2
exit 1
