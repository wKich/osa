#!/bin/sh
# shellcheck shell=sh source-path=SCRIPTDIR
#
# claude-oss: safe workflow helper for running Claude Code inside OpenShell
# sandboxes.
#
# The Claude Code front-end of lib/oss-core.sh, the core it shares with
# maki-oss and opencode-oss. The OpenShell sandbox is the security boundary.
# This helper:
#   - never bind-mounts host directories (project files move with
#     `openshell sandbox upload` / `download`);
#   - never passes credential-like values through `--env` or `--env-from`
#     (provider profiles carry credentials instead);
#   - never reads the host's Claude Code login state (~/.claude/,
#     ~/.config/anthropic, the keychain);
#   - asks for confirmation before deleting a sandbox.
#
# POSIX sh. See docs/claude-oss.md for the differences from maki-oss and
# docs/helper.md for the shared behavior.

set -eu

PROGRAM=claude-oss

agent_usage() {
    cat <<'EOF'
claude-oss: run Claude Code in an OpenShell sandbox.

Usage:
  claude-oss <command> [options] [arguments]

Commands:
  doctor                        Check prerequisites (CLI, gateway, engine,
                                image, policy, providers, model)
  image build                   Build the Claude Code sandbox image
  init, up                      Create or start this project's sandbox
  claude                        Ensure the sandbox and attach the Claude Code
                                TUI (bare `claude-oss` does the same)
  run "<prompt>"                Ensure the sandbox, run Claude Code headless,
                                and print its stream-json events
  upload [PATH] [DEST]          Copy local files into the sandbox
  download [SANDBOX_PATH] DEST  Copy files from the sandbox to the host
  status                        Show this project's sandbox
  list                          List sandboxes on the gateway
  logs                          Show sandbox logs
  start, stop                   Start or stop the sandbox
  rm [--yes]                    Delete the sandbox (confirmation required)
  policy show|edit|apply        Work with the sandbox policy
  policy review                 List pending network-rule proposals
  policy approve CHUNK_ID       Approve one proposal (confirmation required)
  policy reject CHUNK_ID        Reject one proposal (--reason sent to agent)
  provider add|attach|list      Work with provider credentials
  provider setup                Set up a provider from a stored key, a
                                generic key, or a `claude setup-token` token
  mcp status                    Report MCP server readiness in the sandbox
  help                          Show this help

Common options:
  --name NAME      Sandbox name (default: cc-<project directory>), or
                   the provider name for provider setup
  --image REF      Sandbox image (default: claude-agent:local)
  --policy FILE    Sandbox policy YAML
  --provider NAME  Attach a provider at creation (repeatable)
  --cpu QTY        CPU limit (for example: 2, 500m)
  --memory QTY     Memory limit (for example: 4Gi)
  --engine NAME    Container engine: docker or podman
  --gateway NAME   OpenShell gateway to use
  --workdir PATH   In-sandbox project directory (default: /sandbox/project)
  --env KEY=VALUE  Non-secret environment variable at creation (repeatable);
                   for provider setup, the host variable name to read
  --env-from SPEC  Sandbox environment variable read from the caller's
                   environment: KEY or KEY=ENVVAR (repeatable); the
                   credential check covers the sandbox name and the source name
  --allow-env KEY  Allow a credential-like key passed with --env or --env-from
                   (repeatable)
  --model SPEC     Model for sessions and run (an alias such as sonnet, or a
                   full model name); passed as --model
  --continue (-c)  Session commands: continue the most recent session
  --resume ID (-r ID)
                   Session commands: continue session ID
  --session-id ID  Session commands: use session ID (a UUID) for a new session
  --timeout SECS   run: end Claude Code inside the sandbox after SECS seconds
                   (exit 124)
  --no-sync        Session commands: skip collecting changes on exit
                   (default: collect a patch and apply it only when the
                   sandbox baseline matches the host)
  --idle-stop DUR  Session commands: stop the sandbox DUR after the last
                   session closes and no Claude Code runs in it (seconds, or
                   with an s, m, or h suffix; default 1h; 0 disables)
  --yes            Skip confirmation prompts (rm, policy approve, policy set,
                   provider setup)
  --from STORE     provider setup credential store: maki or opencode
  --file PATH      provider setup JSON credential file
  --field PATH     Field path to read from --file (default: .api_key)
  --profile FILE   provider setup profile file (default: the curated catalog)
  --attach         provider setup: attach the provider to the project sandbox
  --no-attach      provider setup: never attach, even interactively
  --tail, --since, --source, --level, -n  Options for logs
  --full, --base   Options for policy show
  --reason TEXT    Reason for policy reject (sent to the agent)
  --type, --credential, --config, --from-existing, --runtime-credentials,
  --global-profile  Options for provider add (provider setup uses
                   --credential as the store slug)
  --claude-version V
                   Build argument for image build (default: the version the
                   Dockerfile pins)

Exit codes: 0 success, 1 usage error, 2 dependency error, 3 gateway error.

Configuration is resolved from flags, then CLAUDE_OSS_<KEY> environment
variables, then the config file below, then built-in defaults:

  ${XDG_CONFIG_HOME:-$HOME/.config}/claude-oss/config.toml

See claude-oss/README.md and docs/claude-oss.md.
EOF
}

# ---------------------------------------------------------------------------
# Locate this script's repository root
# ---------------------------------------------------------------------------

script=$0
case $script in
    */*) ;;
    *) script=$(command -v -- "$script" 2>/dev/null || printf '%s' "$script") ;;
esac
script_dir=$(CDPATH='' cd -- "$(dirname -- "$script")" && pwd -P)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd -P)

# ---------------------------------------------------------------------------
# Identity and defaults read by the core
#
# Set before lib/oss-core.sh is sourced: the core splices them into its
# sandbox-side scripts at source time.
# ---------------------------------------------------------------------------

OSS_ENV_PREFIX=CLAUDE_OSS                # CLAUDE_OSS_<KEY> environment settings
OSS_CONFIG_NAME=claude-oss               # XDG config directory name
OSS_STATE_NAME=.claude-oss               # in-sandbox sync state directory
OSS_TMP_PREFIX=claude-oss                # /tmp/claude-oss-stop, temp file names
OSS_CONFIG_EXAMPLE=docs/claude-oss.md    # named in a generated config header
OSS_PROFILES_DIR=$repo_root/claude-oss/providers
OSS_CATALOG_FILE=$OSS_PROFILES_DIR/stores.tsv
OSS_CUSTOM_PROFILE_PREFIX=claude-        # default id for a custom profile
OSS_AGENT_NAME='Claude Code'             # named in generated profiles
OSS_AGENT_PROCESS=claude                 # in-sandbox process the idle stop waits on
OSS_AGENT_TAG=cc                         # registry agent tag and default name prefix
OSS_HOST_MCP_CONFIG=${CLAUDE_CONFIG_DIR:-${HOME:-/tmp}}/.claude.json
OSS_SANDBOX_MCP_CONFIG=/sandbox/.claude.json
OSS_MCP_PROVIDER_PREFIX=claude-mcp-      # provider name for server <name>
OSS_MCP_FIX_IMAGE='an environment image built FROM claude-agent:local'
OSS_MCP_FIX_DOC=docs/claude-oss.md

DEFAULT_IMAGE=claude-agent:local
DEFAULT_POLICY=$repo_root/claude-oss/policies/minimal.yaml
DEFAULT_NAME='cc-{project}-{hash}'

# profile-id -> example model, read for the post-setup hint.
CC_MODEL_CATALOG=$OSS_PROFILES_DIR/catalog.tsv

# The two curated Anthropic providers. Claude Code prefers the API key when
# both are attached.
CC_KEY_PROVIDER=claude-anthropic
CC_TOKEN_PROVIDER=claude-anthropic-oauth

# Root-owned step in claude-agent:local that approves the attached API key
# placeholder, so the TUI never stops at Claude Code's own approval prompt
# (whose default answer, No, disables the key).
CC_APPROVE_KEY=/usr/local/libexec/claude-oss/approve-api-key

cmd_claude() {
    [ "$#" -eq 0 ] || die_usage "claude takes no arguments"
    # shellcheck disable=SC2119  # the session builds its own argv
    cmd_session
}

# ---------------------------------------------------------------------------
# Agent hooks called by the core
# ---------------------------------------------------------------------------

# Claude Code's --session-id names a new session and must be a UUID; it
# cannot be combined with resuming one. `--continue --resume` is refused by
# the core for every front-end.
agent_check_session_flags() { # interactive|headless
    if [ "$opt_continue" -eq 1 ] && [ -n "$opt_session_id" ]; then
        die_usage "--continue cannot be combined with --session-id"
    fi
    if [ -n "$opt_resume" ] && [ -n "$opt_session_id" ]; then
        die_usage "--resume cannot be combined with --session-id"
    fi
    if [ -n "$opt_session_id" ] && ! printf '%s\n' "$opt_session_id" \
        | grep -Eqx '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'; then
        die_usage "--session-id must be a UUID (for example 123e4567-e89b-12d3-a456-426614174000), got '$opt_session_id'"
    fi
}

# Model and session flags shared by both launch modes; they pass through
# unchanged.
cc_common_flags() {
    if [ -n "$model" ]; then
        argv_add --model "$model"
    fi
    if [ "$opt_continue" -eq 1 ]; then
        argv_add --continue
    fi
    if [ -n "$opt_resume" ]; then
        argv_add --resume "$opt_resume"
    fi
    if [ -n "$opt_session_id" ]; then
        argv_add --session-id "$opt_session_id"
    fi
}

# The approval step runs first in the same exec, then hands the TTY to
# Claude Code. Without an attached API key the step does nothing.
agent_interactive_argv() {
    # shellcheck disable=SC2016  # "$@" is expanded by the sandbox shell
    argv_add sh -c "$CC_APPROVE_KEY; exec \"\$@\"" sh
    argv_add claude --dangerously-skip-permissions
    cc_common_flags
}

agent_headless_argv() { # PROMPT
    argv_add claude -p --output-format stream-json --verbose --dangerously-skip-permissions
    cc_common_flags
    argv_add "$1"
}

# `sandbox exec` leaves stdin open; closing it keeps a headless run from
# ever waiting on input.
agent_exec_stdin() {
    printf 'null'
}

agent_dispatch() { # CMD ARGS...
    ag_cmd=$1
    shift
    case $ag_cmd in
        image)
            if [ "$#" -eq 0 ]; then
                die_usage "image requires a subcommand: build"
            fi
            sub=$1
            shift
            case $sub in
                build) cmd_image_build "$@" ;;
                *) die_usage "unknown image subcommand: $sub" ;;
            esac
            ;;
        claude)
            cmd_claude "$@"
            ;;
        mcp)
            if [ "$#" -eq 0 ]; then
                die_usage "mcp requires a subcommand: status"
            fi
            sub=$1
            shift
            case $sub in
                status)
                    if [ "$have_jq" -eq 0 ]; then
                        die_dep "mcp status needs jq to read .claude.json; install jq"
                    fi
                    cmd_mcp_status "$@"
                    ;;
                *) die_usage "unknown mcp subcommand: $sub" ;;
            esac
            ;;
        *)
            die_usage "unknown command: $ag_cmd"
            ;;
    esac
}

opt_claude_version=

# Consumes --claude-version VALUE; returns 1 for any other option.
agent_parse_option() { # OPT [ARGS...]
    agent_opt_values=0
    case $1 in
        --claude-version)
            [ "$#" -gt 1 ] || die_usage "option --claude-version requires a value"
            opt_claude_version=$2
            agent_opt_values=1
            ;;
        *)
            return 1
            ;;
    esac
}

# Warns when both Anthropic providers are attached to the project sandbox:
# Claude Code then bills the API key, not the subscription. Informational:
# it never fails, and a missing sandbox or gateway skips it.
cc_doctor_precedence() {
    [ "${gateway_ok:-0}" -eq 1 ] || return 0
    cc_name=$(resolved_name 2>/dev/null) || return 0
    cc_json=$(os sandbox provider list "$cc_name" --output json 2>/dev/null) || return 0
    case $cc_json in
        *"\"$CC_KEY_PROVIDER\""*) ;;
        *) return 0 ;;
    esac
    case $cc_json in
        *"\"$CC_TOKEN_PROVIDER\""*) ;;
        *) return 0 ;;
    esac
    say "warn  credentials: $CC_KEY_PROVIDER and $CC_TOKEN_PROVIDER are both attached to '$cc_name'; Claude Code uses the API key ($CC_KEY_PROVIDER), not the subscription; detach one: openshell sandbox provider detach $cc_name <provider>"
}

agent_doctor_extra() {
    doctor_model=$(resolved_model)
    if [ -n "$doctor_model" ]; then
        say "ok    model: $doctor_model"
    else
        say "ok    model: Claude Code's default"
    fi
    cc_doctor_precedence

    if [ "$have_jq" -eq 0 ]; then
        say ""
        say "MCP readiness (informational):"
        say "  skipped: jq not found"
        return 0
    fi
    doctor_mcp_section
}

agent_setup_hint() { # PROFILE
    if [ "$1" = "$CC_TOKEN_PROVIDER" ]; then
        say ""
        say "the token comes from 'claude setup-token' on the host; revoke it from your Claude account if this gateway is compromised"
    fi
    ag_model=$(awk -F'\t' -v id="$1" '$1 == id { print $3; exit }' "$CC_MODEL_CATALOG" 2>/dev/null) || ag_model=
    [ -n "$ag_model" ] || return 0
    say ""
    say "example model: $ag_model"
    say "set it as the default: model = \"$ag_model\" in $config_file"
}

# provider setup with a generic source (--env, --file, or the hidden prompt):
# the two Anthropic credential env vars name their curated profile directly;
# otherwise an interactive wizard asks which credential it is. Sets
# agent_profile_id, or leaves it empty for custom setup.
agent_generic_profile() { # KIND ENV
    case $2 in
        ANTHROPIC_API_KEY)
            agent_profile_id=$CC_KEY_PROVIDER
            return 0
            ;;
        CLAUDE_CODE_OAUTH_TOKEN)
            agent_profile_id=$CC_TOKEN_PROVIDER
            return 0
            ;;
    esac
    is_interactive || return 0
    say "Which credential is this?"
    say "  1) Anthropic API key ($CC_KEY_PROVIDER)"
    say "  2) Claude subscription token from 'claude setup-token' on the host ($CC_TOKEN_PROVIDER)"
    say "  3) Another provider (custom profile)"
    ask "Choice [1]: "
    case ${reply:-1} in
        1) agent_profile_id=$CC_KEY_PROVIDER ;;
        2) agent_profile_id=$CC_TOKEN_PROVIDER ;;
    esac
}

agent_missing_env_hint() { # VAR
    if [ "$1" = CLAUDE_CODE_OAUTH_TOKEN ]; then
        err "create a subscription token with 'claude setup-token' on the host (never in a sandbox), then export it and rerun"
    fi
}

# Prints `name<TAB>transport<TAB>enabled<TAB>host<TAB>argv0` for each server
# under the top-level `mcpServers` key of a .claude.json: `http`/`sse`
# servers (or any with a url) are http with the url's hostname, servers with
# a `command` are stdio. The file has no per-server enabled flag, so every
# listed server is enabled. A missing or empty file has no servers; a file
# jq cannot parse fails, and the core reports it as unreadable.
agent_mcp_servers() { # FILE
    [ -s "$1" ] || return 0
    jq -r '
        (.mcpServers // {}) | to_entries[]
        | .value as $v
        | [ .key,
            (if ($v.type == "http") or ($v.type == "sse") or ($v.url != null) then "http"
             elif $v.command != null then "stdio"
             else "unknown" end),
            "true",
            (($v.url // "") | sub("^[a-zA-Z][a-zA-Z0-9+.-]*://"; "") | sub("[/:?].*$"; "")),
            (if ($v.command | type) == "string" then $v.command else "" end) ]
        | @tsv
    ' "$1" 2>/dev/null
}

# ---------------------------------------------------------------------------
# image build
# ---------------------------------------------------------------------------

cmd_image_build() {
    [ "$#" -eq 0 ] || die_usage "image build takes no arguments"
    context=$repo_root/claude-oss/image
    if [ ! -d "$context" ]; then
        die_dep "missing $context; keep the repository layout or build your image elsewhere"
    fi
    engine=$(resolved_engine)
    if ! command -v "$engine" >/dev/null 2>&1; then
        die_dep "container engine '$engine' not found on PATH"
    fi
    # The base build never uses the configured `image`: that may name a derived
    # environment, and tagging the base with it would overwrite the environment.
    image=$(resolve_setting "$opt_image" "$(env_setting IMAGE)" "" "$DEFAULT_IMAGE")
    set -- build
    if [ -n "$opt_claude_version" ]; then
        set -- "$@" --build-arg "CLAUDE_VERSION=$opt_claude_version"
    fi
    set -- "$@" -t "$image" "$context"
    say "Building image '$image' with $engine..."
    image_build_rc=0
    "$engine" "$@" || image_build_rc=$?
    if [ "$image_build_rc" -ne 0 ]; then
        if [ -n "$opt_claude_version" ]; then
            err "the Dockerfile verifies a pinned sha256 per architecture; a new"
            err "  CLAUDE_VERSION needs matching CLAUDE_SHA256_ARM64/AMD64 values"
            err "  (see 'Build the image' in claude-oss/README.md)"
        fi
        die_dep "image build failed (exit status $image_build_rc)"
    fi
    say "Built image '$image'."
}

# shellcheck source=../lib/oss-core.sh
. "$repo_root/lib/oss-core.sh"

oss_main "$@"
