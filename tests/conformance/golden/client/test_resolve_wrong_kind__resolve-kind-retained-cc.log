@transport client
@client
provider list --names
sandbox get cc-myproject --output json
sandbox get cc-myproject --output json
sandbox exec -n cc-myproject --no-login-shell -- sh -c mkdir -p "$1" claude-oss-git <case>/sandbox/project
sandbox exec -n cc-myproject --no-login-shell --workdir <case>/sandbox/project -- sh -c set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
if ! git rev-parse -q --verify refs/claude-oss/base >/dev/null 2>&1; then
    printf "missing\n"
    exit 0
fi
index=$gitdir/tree-index.$$
rm -f "$index"
if ! GIT_INDEX_FILE=$index git add -A 2>/dev/null; then
    rm -f "$index"
    printf "missing\n"
    exit 0
fi
tree=$(GIT_INDEX_FILE=$index git write-tree)
rm -f "$index"
printf "%s\n" "$tree" claude-oss-git <case>/sandbox/.claude-oss/git <case>/sandbox/project
sandbox exec -n cc-myproject --no-login-shell --workdir <case>/sandbox/project -- sh -c set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
export GIT_AUTHOR_NAME=claude-oss GIT_AUTHOR_EMAIL=claude-oss@localhost
export GIT_COMMITTER_NAME=claude-oss GIT_COMMITTER_EMAIL=claude-oss@localhost
mkdir -p "$gitdir" "$worktree"
git init -q
git add -A
tree=$(git write-tree)
commit=$(git commit-tree "$tree" -m "claude-oss baseline")
git update-ref refs/claude-oss/base "$commit"
printf "%s\n" "$tree" claude-oss-git <case>/sandbox/.claude-oss/git <case>/sandbox/project
sandbox provider list cc-myproject --output json
sandbox exec -n cc-myproject --no-login-shell --workdir <case>/sandbox/project -- claude -p --output-format stream-json --verbose --dangerously-skip-permissions edit
sandbox exec -n cc-myproject --no-login-shell --workdir <case>/sandbox/project -- sh -c set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
export GIT_AUTHOR_NAME=claude-oss GIT_AUTHOR_EMAIL=claude-oss@localhost
export GIT_COMMITTER_NAME=claude-oss GIT_COMMITTER_EMAIL=claude-oss@localhost
git add -A
tree=$(git write-tree)
commit=$(git commit-tree "$tree" -p refs/claude-oss/base -m "claude-oss result")
git update-ref refs/claude-oss/result "$commit"
git diff --binary --full-index refs/claude-oss/base refs/claude-oss/result claude-oss-git <case>/sandbox/.claude-oss/git <case>/sandbox/project
sandbox exec -n cc-myproject --no-login-shell --workdir <case>/sandbox/project -- sh -c set -e
export GIT_DIR=$1
git rev-parse -q --verify refs/claude-oss/result^{tree} 2>/dev/null || true claude-oss-git <case>/sandbox/.claude-oss/git <case>/sandbox/project
rule get cc-myproject --status pending
