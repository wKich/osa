@transport client
@client
provider list --names
sandbox get maki-myproject --output json
sandbox get maki-myproject --output json
sandbox exec -n maki-myproject --no-login-shell -- sh -c mkdir -p "$1" maki-oss-git <case>/sandbox/project
sandbox exec -n maki-myproject --no-login-shell --workdir <case>/sandbox/project -- sh -c set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
if ! git rev-parse -q --verify refs/maki-oss/base >/dev/null 2>&1; then
    printf "missing\n"
    exit 0
fi
index=$gitdir/tree-index.$$
rm -f "$index"
if ! GIT_INDEX_FILE=$index git add -A 2>/dev/null; then
    rm -f "$index"
    printf "missing\n"
    exit 0
fi
tree=$(GIT_INDEX_FILE=$index git write-tree)
rm -f "$index"
printf "%s\n" "$tree" maki-oss-git <case>/sandbox/.maki-oss/git <case>/sandbox/project
sandbox exec -n maki-myproject --no-login-shell --workdir <case>/sandbox/project -- sh -c set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
export GIT_AUTHOR_NAME=maki-oss GIT_AUTHOR_EMAIL=maki-oss@localhost
export GIT_COMMITTER_NAME=maki-oss GIT_COMMITTER_EMAIL=maki-oss@localhost
mkdir -p "$gitdir" "$worktree"
git init -q
git add -A
tree=$(git write-tree)
commit=$(git commit-tree "$tree" -m "maki-oss baseline")
git update-ref refs/maki-oss/base "$commit"
printf "%s\n" "$tree" maki-oss-git <case>/sandbox/.maki-oss/git <case>/sandbox/project
sandbox provider list maki-myproject --output json
sandbox exec -n maki-myproject --no-login-shell --workdir <case>/sandbox/project -- sh -c tag=$1; secs=$2; shift 2
stop=<tmp>/<entry>/$tag
rm -f "$stop"
export MAKI_OSS_RUN_TAG="$tag"
exec 3<&0
timeout --kill-after=10 "$secs" "$@" <&3 3<&- &
exec 3<&-
child=$!
while kill -0 "$child" 2>/dev/null; do
    if [ -e "$stop" ]; then kill -TERM "$child" 2>/dev/null; break; fi
    sleep 1
done
wait "$child"
rc=$?
unset MAKI_OSS_RUN_TAG
for d in /proc/[0-9]*; do
    if grep -qzx "MAKI_OSS_RUN_TAG=$tag" "$d/environ" 2>/dev/null; then
        kill -KILL "${d#/proc/}" 2>/dev/null
    fi
done
rm -f "$stop"
exit "$rc" maki-oss-run maki-oss-<pid>-<epoch> 600 maki --print --yolo --trust --output-format stream-json --verbose check
sandbox exec -n maki-myproject --no-login-shell --workdir <case>/sandbox/project -- sh -c set -e
