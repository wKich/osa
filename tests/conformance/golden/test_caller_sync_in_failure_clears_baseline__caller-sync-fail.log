@env MAKI_OSS_WORKSPACE
@env MAKI_VERSION
---
sandbox
exec
-n
repo-app
--no-login-shell
--
sh
-c
set -e
gitdir=$1 worktree=$2 repodir=$3 bundle=$4 manifest=$5 dirty=$6
rm -rf "$gitdir" "$repodir" "$bundle" "$manifest" "$dirty"
mkdir -p "$(dirname -- "$gitdir")" "$worktree"
find "$worktree" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
