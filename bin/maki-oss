#!/bin/sh
# shellcheck shell=sh source-path=SCRIPTDIR
#
# maki-oss: safe workflow helper for running Maki inside OpenShell sandboxes.
#
# The OpenShell sandbox is the security boundary. This helper:
#   - never bind-mounts host directories (project files move with
#     `openshell sandbox upload` / `download`);
#   - never passes credential-like values through `--env` or `--env-from`
#     (provider profiles carry credentials instead);
#   - asks for confirmation before deleting a sandbox.
#
# POSIX sh. See docs/helper.md for the full reference.

set -eu

PROGRAM=maki-oss

agent_usage() {
    cat <<'EOF'
maki-oss: run Maki in an OpenShell sandbox.

Usage:
  maki-oss <command> [options] [arguments]

Commands:
  doctor                        Check prerequisites (CLI, gateway, engine,
                                image, policy, providers)
  image build                   Build the Maki sandbox image
  init, up                      Create or start this project's sandbox
  maki                          Ensure the sandbox and attach an interactive
                                Maki session (bare `maki-oss` does the same)
  run "<prompt>"                Ensure the sandbox, run Maki headless, and
                                print its JSON output
  upload [--discard] [PATH] [DEST]
                                Refresh the workspace from local files
                                (--discard replaces parked changes)
  download [SANDBOX_PATH] DEST  Copy files from the sandbox to the host
  status                        Show the sandbox and workspace sync state
  list                          List sandboxes on the gateway
  logs                          Show sandbox logs
  start, stop                   Start or stop the sandbox
  rm [--yes] [--discard]        Delete the sandbox (confirmation required;
                                --discard deletes a parked workspace)
  policy show|edit|apply        Work with the sandbox policy
  policy review                 List pending network-rule proposals
  policy approve CHUNK_ID       Approve one proposal (confirmation required)
  policy reject CHUNK_ID        Reject one proposal (--reason sent to agent)
  provider add|attach|list      Work with provider credentials
  provider setup                Set up a provider from a stored or generic key
  mcp status                    Report MCP server readiness in the sandbox
  fish install|uninstall        Install or remove the fish plugin
  help                          Show this help

Common options:
  --name NAME      Sandbox name (default: maki-<project directory>), or the
                   provider name for provider setup
  --image REF      Sandbox image (default: maki-agent:local)
  --policy FILE    Sandbox policy YAML
  --provider NAME  Attach a provider at creation (repeatable)
  --cpu QTY        CPU limit (for example: 2, 500m)
  --memory QTY     Memory limit (for example: 4Gi)
  --engine NAME    Container engine: docker or podman
  --gateway NAME   OpenShell gateway to use
  --workdir PATH   In-sandbox project directory (default: /sandbox/project)
  --env KEY=VALUE  Non-secret environment variable at creation (repeatable);
                   for provider setup, the host variable name to read
  --env-from SPEC  Sandbox environment variable read from the caller's
                   environment: KEY or KEY=ENVVAR (repeatable); the
                   credential check covers the sandbox name and the source name
  --allow-env KEY  Allow a credential-like key passed with --env or --env-from
                   (repeatable)
  --model SPEC     Model for sessions and run (provider/model)
  --continue (-c)  Session commands: resume the most recent session in the
                    sandbox workdir (sessions live in the sandbox: they
                    survive stop/start, but not deletion of the sandbox)
  --resume ID (-r ID)
                    Session commands: resume a specific session by id
  --session-id ID  Session commands: write the run under a chosen session id
  --timeout SECS   run: end Maki inside the sandbox after SECS seconds
                   (exit 124)
  --no-sync        Session commands: skip collecting changes on exit and
                   park the workspace (default: collect a patch and apply it
                   only when the sandbox baseline matches the host)
  --discard        upload: replace a parked workspace; rm: delete a parked
                   workspace's unique changes (both keep patch files)
  --idle-stop DUR  Session commands: stop the sandbox DUR after the last
                   session closes and no Maki runs in it (seconds, or with
                   an s, m, or h suffix; default 1h; 0 disables)
  --yes            Skip confirmation prompts (rm, policy approve, policy set,
                    provider setup)
  --from STORE     provider setup credential store: maki or opencode
  --file PATH      provider setup JSON credential file
  --field PATH     Field path to read from --file (default: .api_key)
  --profile FILE   provider setup profile file (default: the curated catalog)
  --attach         provider setup: attach the provider to the project sandbox
  --no-attach      provider setup: never attach, even interactively
  --tail, --since, --source, --level, -n  Options for logs
  --full, --base   Options for policy show
  --reason TEXT    Reason for policy reject (sent to the agent)
  --type, --credential, --config, --from-existing, --runtime-credentials,
  --global-profile  Options for provider add (provider setup uses
                   --credential as the store slug)
  --maki-version V Build argument for image build (default: $MAKI_VERSION)

Exit codes: 0 success, 1 usage error, 2 dependency error, 3 gateway error.

Configuration is resolved from flags, then MAKI_OSS_<KEY> environment
variables, then the config file below, then built-in defaults:

  ${XDG_CONFIG_HOME:-$HOME/.config}/maki-oss/config.toml

See README.md and docs/helper.md for the cookbook.
EOF
}

# ---------------------------------------------------------------------------
# Locate this script's repository root
# ---------------------------------------------------------------------------

script=$0
case $script in
    */*) ;;
    *) script=$(command -v -- "$script" 2>/dev/null || printf '%s' "$script") ;;
esac
script_dir=$(CDPATH='' cd -- "$(dirname -- "$script")" && pwd -P)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd -P)

# ---------------------------------------------------------------------------
# Identity and defaults read by the core
#
# Set before lib/oss-core.sh is sourced: the core splices them into its
# sandbox-side scripts at source time.
# ---------------------------------------------------------------------------

OSS_ENV_PREFIX=MAKI_OSS                  # MAKI_OSS_<KEY> environment settings
OSS_CONFIG_NAME=maki-oss                 # XDG config and state directory name
OSS_STATE_NAME=.maki-oss                 # in-sandbox sync state directory
OSS_TMP_PREFIX=maki-oss                  # /tmp/maki-oss-stop, temp file names
OSS_CONFIG_EXAMPLE=examples/config.toml  # named in a generated config header
OSS_PROFILES_DIR=$repo_root/examples/providers
OSS_CATALOG_FILE=$OSS_PROFILES_DIR/catalog.tsv
OSS_CUSTOM_PROFILE_PREFIX=maki-          # default id for a custom profile
OSS_AGENT_NAME=Maki                      # named in generated profiles
OSS_AGENT_PROCESS=maki                   # in-sandbox process the idle stop waits on
OSS_HOST_MCP_CONFIG=${HOME:-/tmp}/.config/maki/mcp.toml
OSS_SANDBOX_MCP_CONFIG=/sandbox/.config/maki/mcp.toml
OSS_MCP_PROVIDER_PREFIX=mcp-            # provider name for server <name>
OSS_MCP_FIX_IMAGE='an environment image' # named in mcp status fix hints
OSS_MCP_FIX_DOC=docs/ai/environment-playbook.md

DEFAULT_IMAGE=maki-agent:local
DEFAULT_POLICY=$repo_root/examples/policies/maki-minimal.yaml
DEFAULT_NAME='maki-{project}'

# The interactive TUI (no flag: config/env only). Unset keeps Maki's own TTY
# session; "opencode" runs the OpenCode TUI against the local bridge. Anything
# else is a usage error naming the key and the accepted values.
resolved_tui() {
    tui_value=$(resolve_setting "" "${MAKI_OSS_TUI:-}" "$config_tui" "")
    case $tui_value in
        ''|opencode)
            printf '%s' "$tui_value"
            ;;
        *)
            die_usage "invalid 'tui' value <$tui_value>: accepted values are \"opencode\" (or leave the key unset for Maki's own TUI)"
            ;;
    esac
}

cmd_maki() {
    [ "$#" -eq 0 ] || die_usage "maki takes no arguments"
    # shellcheck disable=SC2119  # the session builds its own argv
    cmd_session
}

# ---------------------------------------------------------------------------
# Agent hooks called by the core
# ---------------------------------------------------------------------------

# Session flags and OpenCode TUI mode. The mode is decided before any sandbox
# or bridge work so an invalid value or a refused resume flag never starts a
# session; in OpenCode mode the bridge takes over the session and exits.
agent_check_session_flags() { # interactive|headless
    [ "$1" = interactive ] || return 0
    maki_tui=$(resolved_tui)
    if [ "$maki_tui" = opencode ]; then
        if [ "$opt_continue" -eq 1 ] || [ -n "$opt_resume" ] || [ -n "$opt_session_id" ]; then
            die_usage "--continue, --resume, and --session-id are unsupported in OpenCode TUI mode (tui = \"opencode\"); unset the tui setting to use Maki's TUI"
        fi
        cmd_opencode_tui
    fi
}

maki_session_flags() {
    if [ -n "$model" ]; then
        argv_add --model "$model"
    fi
    if [ "$opt_continue" -eq 1 ]; then
        argv_add --continue
    fi
    if [ -n "$opt_resume" ]; then
        argv_add --resume "$opt_resume"
    fi
    if [ -n "$opt_session_id" ]; then
        argv_add --session-id "$opt_session_id"
    fi
}

agent_interactive_argv() {
    argv_add maki
    maki_session_flags
}

agent_headless_argv() { # PROMPT
    argv_add maki --print --yolo --trust --output-format json
    maki_session_flags
    argv_add "$1"
}

# Maki's headless run keeps the inherited stdin.
agent_exec_stdin() {
    printf 'tty'
}

agent_dispatch() { # CMD ARGS...
    ag_cmd=$1
    shift
    case $ag_cmd in
        image)
            if [ "$#" -eq 0 ]; then
                die_usage "image requires a subcommand: build"
            fi
            sub=$1
            shift
            case $sub in
                build) cmd_image_build "$@" ;;
                *) die_usage "unknown image subcommand: $sub" ;;
            esac
            ;;
        maki)
            cmd_maki "$@"
            ;;
        mcp)
            if [ "$#" -eq 0 ]; then
                die_usage "mcp requires a subcommand: status"
            fi
            sub=$1
            shift
            case $sub in
                status) cmd_mcp_status "$@" ;;
                *) die_usage "unknown mcp subcommand: $sub" ;;
            esac
            ;;
        fish)
            if [ "$#" -eq 0 ]; then
                die_usage "fish requires a subcommand: install, uninstall"
            fi
            sub=$1
            shift
            case $sub in
                install) cmd_fish_install "$@" ;;
                uninstall) cmd_fish_uninstall "$@" ;;
                *) die_usage "unknown fish subcommand: $sub" ;;
            esac
            ;;
        *)
            die_usage "unknown command: $ag_cmd"
            ;;
    esac
}

opt_maki_version=

# Consumes --maki-version VALUE; returns 1 for any other option.
agent_parse_option() { # OPT [ARGS...]
    agent_opt_values=0
    case $1 in
        --maki-version)
            [ "$#" -gt 1 ] || die_usage "option --maki-version requires a value"
            opt_maki_version=$2
            agent_opt_values=1
            ;;
        *)
            return 1
            ;;
    esac
}

agent_doctor_extra() {
    # TUI prerequisites are conditional: checked only when tui resolves to
    # opencode, so a host without bun or opencode stays healthy by default
    # (helper-cli: Prerequisite diagnostics).
    doctor_tui=$(resolved_tui)
    if [ "$doctor_tui" = opencode ]; then
        if command -v bun >/dev/null 2>&1; then
            say "ok    bun: $(command -v bun)"
        else
            say "fail  bun: not found on PATH (required by tui = \"opencode\")"
            doctor_status=$EX_DEP
        fi
        if command -v opencode >/dev/null 2>&1; then
            say "ok    opencode: $(command -v opencode)"
        else
            say "fail  opencode: not found on PATH (required by tui = \"opencode\")"
            doctor_status=$EX_DEP
        fi
        if [ -f "$BRIDGE_ENTRYPOINT" ]; then
            say "ok    bridge entrypoint: $BRIDGE_ENTRYPOINT"
        else
            say "fail  bridge entrypoint: $BRIDGE_ENTRYPOINT not found"
            doctor_status=$EX_DEP
        fi
    fi

    doctor_mcp_section
}

agent_setup_hint() { # PROFILE
    if [ "$1" = maki-zai-coding ]; then
        say ""
        say "Z.AI coding plan: add the following to the sandbox's Maki providers.toml"
        say "(~/.config/maki/providers.toml) before the first request:"
        say ""
        say '  [zai]'
        say '  plan = "coding"'
    fi
}

# ---------------------------------------------------------------------------
# OpenCode TUI mode (tui = "opencode")
#
# The helper owns the sandbox lifecycle, the bridge owns the wire (design
# decision 3): run the existing ensure routine, export the bridge environment,
# start `bun bridge/...` in the background, wait for its listen line, attach
# `opencode --server` on the TTY, and on exit kill the bridge — the EXIT trap
# then runs the usual sync and proposal check (design decision 4: teardown
# order). No bind mounts, no --env values: everything crosses sandbox stdio.
# ---------------------------------------------------------------------------

BRIDGE_ENTRYPOINT=$repo_root/bridge/src/bridge.ts

# Prints the port once the bridge's listen line reaches LOGFILE; fails as a
# dependency error if the bridge dies or goes quiet first.
wait_for_bridge_port() { # LOGFILE PID
    wfbp_log=$1
    wfbp_pid=$2
    wfbp_attempts=0
    while :; do
        wfbp_port=$(sed -n 's|.*bridge listening on http://127\.0\.0\.1:\([0-9][0-9]*\).*|\1|p' "$wfbp_log" 2>/dev/null | head -n 1)
        if [ -n "$wfbp_port" ]; then
            printf '%s' "$wfbp_port"
            return 0
        fi
        if ! kill -0 "$wfbp_pid" 2>/dev/null; then
            sed 's/^/  /' "$wfbp_log" >&2 2>/dev/null || true
            die_dep "bridge exited before listening; tui = \"opencode\" needs bun and the bridge entrypoint ($BRIDGE_ENTRYPOINT)"
        fi
        wfbp_attempts=$((wfbp_attempts + 1))
        if [ "$wfbp_attempts" -gt 10 ]; then
            kill "$wfbp_pid" 2>/dev/null || true
            die_dep "bridge reported no listen address within 10 seconds"
        fi
        sleep 1
    done
}

cmd_opencode_tui() {
    require_openshell
    arm_idle_stop "$session_idle_stop"
    ensure_project_sandbox
    ot_name=$(resolved_name)
    ot_workdir=$(resolved_workdir)
    ot_model=$(resolved_model)
    ot_openshell=$(command -v openshell)
    arm_sync
    ot_bridge_log=${TMPDIR:-/tmp}/maki-oss-bridge.$$.log
    ot_bridge_pid=
    ot_interrupted=0
    trap 'ot_interrupted=1; if [ -n "$ot_bridge_pid" ]; then kill "$ot_bridge_pid" 2>/dev/null || true; fi' INT TERM
    ot_rc=0
    note "Starting the OpenCode TUI bridge..."
    # PORT stays inherited when the user exported it (documented override);
    # the attach URL comes from the bridge's listen line either way.
    (
        OPENSHELL_BIN=$ot_openshell \
        OPENMAKI_SANDBOX=$ot_name \
        OPENMAKI_CWD=$ot_workdir \
        MAKI_MODEL=$ot_model \
        bun "$BRIDGE_ENTRYPOINT"
    ) >"$ot_bridge_log" 2>&1 &
    ot_bridge_pid=$!
    ot_port=$(wait_for_bridge_port "$ot_bridge_log" "$ot_bridge_pid")
    note "Attaching the OpenCode TUI (server http://127.0.0.1:$ot_port)..."
    opencode --server "http://127.0.0.1:$ot_port" || ot_rc=$?
    kill "$ot_bridge_pid" 2>/dev/null || true
    wait "$ot_bridge_pid" 2>/dev/null || true
    rm -f "$ot_bridge_log"
    trap - INT TERM
    if [ "$ot_interrupted" -eq 1 ] && [ "$ot_rc" -eq 0 ]; then
        ot_rc=130
    fi
    exit "$ot_rc"
}

# ---------------------------------------------------------------------------
# MCP readiness: mcp status and the doctor section
#
# The core compares the servers enabled in the host's ~/.config/maki/mcp.toml
# against the sandbox's baked /sandbox/.config/maki/mcp.toml; this parser
# reads one file. It never parses or prints a credential value (headers and
# environment values are skipped).
# ---------------------------------------------------------------------------

# agent_mcp_servers hook: the core's MCP gate table reads this format.
agent_mcp_servers() { # FILE
    mcp_servers_in_toml "$1"
}

# Prints `name<TAB>transport<TAB>enabled<TAB>host<TAB>argv0` for each
# [mcp.NAME] server in a maki mcp.toml. Transport is `http` (url) or `stdio`
# (command); host is the url's hostname, empty for stdio; argv0 is the first
# word of the `command` array (the runtime a stdio server needs), empty for
# http; enabled defaults to true. The first four fields keep the contract the
# HTTP consumers already parse.
mcp_servers_in_toml() { # FILE
    [ -f "$1" ] || return 0
    awk '
        function flush() {
            if (name != "") {
                if (url != "") { transport = "http"; host = url
                    sub(/^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//, "", host)
                    sub(/[\/:?].*$/, "", host)
                } else if (cmd != "") { transport = "stdio"; host = "" }
                else { transport = "unknown"; host = "" }
                printf "%s\t%s\t%s\t%s\t%s\n", name, transport, enabled, host, cmd
            }
        }
        /^[[:space:]]*\[mcp\./ {
            flush()
            name = $0
            sub(/^[[:space:]]*\[mcp\./, "", name)
            sub(/\].*$/, "", name)
            url = ""; cmd = ""; enabled = "true"
            next
        }
        /^[[:space:]]*\[/ { flush(); name = ""; next }
        name == "" { next }
        /^[[:space:]]*url[[:space:]]*=/ {
            line = $0
            sub(/^[^=]*=[[:space:]]*/, "", line)
            gsub(/^"|"[[:space:]]*$/, "", line)
            url = line
            next
        }
        /^[[:space:]]*command[[:space:]]*=/ {
            # Record argv[0] (the runtime), not a bare present-flag: one
            # single-line TOML array, the shape maki itself writes.
            line = $0
            sub(/^[^=]*=[[:space:]]*/, "", line)
            gsub(/^[[:space:]]*\[|[[:space:]]*\][[:space:]]*$/, "", line)
            sub(/,[[:space:]]*.*$/, "", line)
            gsub(/^[[:space:]]*"|[[:space:]]*"[[:space:]]*$/, "", line)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
            cmd = line
            next
        }
        /^[[:space:]]*enabled[[:space:]]*=/ {
            line = $0
            sub(/^[^=]*=[[:space:]]*/, "", line)
            if (line ~ /^false/) { enabled = "false" }
            next
        }
        END { flush() }
    ' "$1"
}

cmd_image_build() {
    [ "$#" -eq 0 ] || die_usage "image build takes no arguments"
    context=$repo_root/examples/maki-image
    if [ ! -d "$context" ]; then
        die_dep "missing $context; keep the repository layout or build your image elsewhere"
    fi
    engine=$(resolved_engine)
    if ! command -v "$engine" >/dev/null 2>&1; then
        die_dep "container engine '$engine' not found on PATH"
    fi
    # The base build never uses the configured `image`: that may name a derived
    # environment, and tagging the base with it would overwrite the environment.
    image=$(resolve_setting "$opt_image" "${MAKI_OSS_IMAGE:-}" "" "$DEFAULT_IMAGE")
    version=$opt_maki_version
    if [ -z "$version" ]; then
        version=${MAKI_VERSION:-}
    fi
    set -- build
    if [ -n "$version" ]; then
        set -- "$@" --build-arg "MAKI_VERSION=$version"
    fi
    set -- "$@" -t "$image" "$context"
    say "Building image '$image' with $engine..."
    image_build_rc=0
    "$engine" "$@" || image_build_rc=$?
    if [ "$image_build_rc" -ne 0 ]; then
        die_dep "image build failed (exit status $image_build_rc)"
    fi
    say "Built image '$image'."
}

cmd_fish_install() {
    [ "$#" -eq 0 ] || die_usage "fish install takes no arguments"
    fish_home=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/fish
    failed=0
    for entry in functions/maki-oss.fish completions/maki-oss.fish; do
        src=$repo_root/fish/$entry
        dest=$fish_home/$entry
        if [ ! -e "$src" ]; then
            err "missing plugin file: $src"
            failed=1
            continue
        fi
        if [ -L "$dest" ]; then
            target=$(readlink "$dest")
            if [ "$target" = "$src" ]; then
                say "already installed: $dest"
            else
                case $target in
                    "$repo_root"/*)
                        ln -sfn "$src" "$dest"
                        say "relinked: $dest"
                        ;;
                    *)
                        err "skipped $dest: existing symlink points outside this repository"
                        failed=1
                        ;;
                esac
            fi
        elif [ -e "$dest" ]; then
            err "skipped $dest: file exists and was not installed by $PROGRAM"
            failed=1
        else
            mkdir -p -- "$(dirname -- "$dest")"
            ln -s "$src" "$dest"
            say "linked: $dest -> $src"
        fi
    done
    if [ "$failed" -ne 0 ]; then
        exit "$EX_USAGE"
    fi
    say "Fish plugin installed; open a new fish session to use it."
}

cmd_fish_uninstall() {
    [ "$#" -eq 0 ] || die_usage "fish uninstall takes no arguments"
    fish_home=${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/fish
    for entry in functions/maki-oss.fish completions/maki-oss.fish; do
        dest=$fish_home/$entry
        if [ -L "$dest" ]; then
            target=$(readlink "$dest")
            case $target in
                "$repo_root"/*)
                    rm -f "$dest"
                    say "removed: $dest"
                    ;;
                *)
                    say "skipped (not installed by $PROGRAM): $dest"
                    ;;
            esac
        elif [ -e "$dest" ]; then
            say "skipped (not a symlink from this repository): $dest"
        else
            say "not installed: $dest"
        fi
    done
}

# shellcheck source=../lib/oss-core.sh
. "$repo_root/lib/oss-core.sh"

oss_main "$@"
