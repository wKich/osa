op=get_sandbox
target=<sandbox>

op=create_sandbox
target=<sandbox>
cpu=
env=PATH
env_from=
image=osa-dev:local
memory=
policy=<repo>/claude-oss/policies/minimal.yaml
providers=e2e-noop

op=get_sandbox
target=<sandbox>

op=list_providers
target=<gateway>

op=get_sandbox
target=<sandbox>

op=get_sandbox
target=<sandbox>

op=exec_buffered
target=<sandbox>
command=sh -c mkdir -p "$1" claude-oss-git /sandbox/project
no_login_shell=true
workdir=

op=exec_buffered
target=<sandbox>
command=sh -c set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
if ! git rev-parse -q --verify refs/claude-oss/base >/dev/null 2>&1; then
    printf "missing\n"
    exit 0
fi
index=$gitdir/tree-index.$$
rm -f "$index"
if ! GIT_INDEX_FILE=$index git add -A 2>/dev/null; then
    rm -f "$index"
    printf "missing\n"
    exit 0
fi
tree=$(GIT_INDEX_FILE=$index git write-tree)
rm -f "$index"
printf "%s\n" "$tree" claude-oss-git /sandbox/.claude-oss/git /sandbox/project
no_login_shell=true
workdir=/sandbox/project

op=exec_buffered
target=<sandbox>
command=sh -c set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
export GIT_AUTHOR_NAME=claude-oss GIT_AUTHOR_EMAIL=claude-oss@localhost
export GIT_COMMITTER_NAME=claude-oss GIT_COMMITTER_EMAIL=claude-oss@localhost
mkdir -p "$gitdir" "$worktree"
git init -q
git add -A
tree=$(git write-tree)
commit=$(git commit-tree "$tree" -m "claude-oss baseline")
git update-ref refs/claude-oss/base "$commit"
printf "%s\n" "$tree" claude-oss-git /sandbox/.claude-oss/git /sandbox/project
no_login_shell=true
workdir=/sandbox/project

op=exec_buffered
target=<sandbox>
command=sh -c set -e
export GIT_DIR=$1
tree=$3
if [ -z "$tree" ] || [ -z "$(git ls-tree -r --name-only "$tree" 2>/dev/null | head -n 1)" ]; then
    printf "empty\n"
else
    printf "nonempty\n"
fi claude-oss-git /sandbox/.claude-oss/git /sandbox/project <commit>
no_login_shell=true
workdir=/sandbox/project

op=exec_buffered
target=<sandbox>
command=sh -c set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
export GIT_AUTHOR_NAME=claude-oss GIT_AUTHOR_EMAIL=claude-oss@localhost
export GIT_COMMITTER_NAME=claude-oss GIT_COMMITTER_EMAIL=claude-oss@localhost
mkdir -p "$gitdir" "$worktree"
git init -q
git add -A
tree=$(git write-tree)
commit=$(git commit-tree "$tree" -m "claude-oss baseline")
git update-ref refs/claude-oss/base "$commit"
printf "%s\n" "$tree" claude-oss-git /sandbox/.claude-oss/git /sandbox/project
no_login_shell=true
workdir=/sandbox/project

op=attached_providers
target=<sandbox>

op=exec_interactive
target=<sandbox>
command=claude -p --output-format stream-json --verbose --dangerously-skip-permissions e2e idle prompt
env=
no_login_shell=true
size=None
tty=false
workdir=/sandbox/project

op=exec_buffered
target=<sandbox>
command=sh -c set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
export GIT_AUTHOR_NAME=claude-oss GIT_AUTHOR_EMAIL=claude-oss@localhost
export GIT_COMMITTER_NAME=claude-oss GIT_COMMITTER_EMAIL=claude-oss@localhost
git add -A
tree=$(git write-tree)
commit=$(git commit-tree "$tree" -p refs/claude-oss/base -m "claude-oss result")
git update-ref refs/claude-oss/result "$commit"
git diff --binary --full-index refs/claude-oss/base refs/claude-oss/result claude-oss-git /sandbox/.claude-oss/git /sandbox/project
no_login_shell=true
workdir=/sandbox/project

op=exec_buffered
target=<sandbox>
command=sh -c set -e
export GIT_DIR=$1
git rev-parse -q --verify refs/claude-oss/result^{tree} 2>/dev/null || true claude-oss-git /sandbox/.claude-oss/git /sandbox/project
no_login_shell=true
workdir=/sandbox/project

op=exec_buffered
target=<sandbox>
command=sh -c set -e
export GIT_DIR=$1
git update-ref refs/claude-oss/base refs/claude-oss/result claude-oss-git /sandbox/.claude-oss/git /sandbox/project
no_login_shell=true
workdir=/sandbox/project

op=exec_buffered
target=<sandbox>
command=sh -c set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
if ! git rev-parse -q --verify refs/claude-oss/base >/dev/null 2>&1; then
    printf "missing\n"
    exit 0
fi
index=$gitdir/tree-index.$$
rm -f "$index"
if ! GIT_INDEX_FILE=$index git add -A 2>/dev/null; then
    rm -f "$index"
    printf "missing\n"
    exit 0
fi
tree=$(GIT_INDEX_FILE=$index git write-tree)
rm -f "$index"
printf "%s\n" "$tree" claude-oss-git /sandbox/.claude-oss/git /sandbox/project
no_login_shell=true
workdir=/sandbox/project

op=list_rules
target=<sandbox>

op=exec_buffered
target=<sandbox>
command=sh -c for f in /proc/[0-9]*/comm; do
    c=
    { read -r c <"$f"; } 2>/dev/null || continue
    if [ "$c" = claude ]; then printf "busy\n"; exit 0; fi
done
printf "idle\n" claude-oss-idle
no_login_shell=true
workdir=

op=stop_sandbox
target=<sandbox>

