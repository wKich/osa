---
sandbox
exec
-n
oc-myproject
--no-login-shell
--workdir
<case>/sandbox/project
--
sh
-c
set -e
gitdir=$1 worktree=$2
export GIT_DIR=$gitdir GIT_WORK_TREE=$worktree
export GIT_AUTHOR_NAME=opencode-oss GIT_AUTHOR_EMAIL=opencode-oss@localhost
export GIT_COMMITTER_NAME=opencode-oss GIT_COMMITTER_EMAIL=opencode-oss@localhost
mkdir -p "$gitdir" "$worktree"
git init -q
git add -A
tree=$(git write-tree)
commit=$(git commit-tree "$tree" -m "opencode-oss baseline")
git update-ref refs/opencode-oss/base "$commit"
printf "%s\n" "$tree"
opencode-oss-git
<case>/sandbox/.opencode-oss/git
<case>/sandbox/project
