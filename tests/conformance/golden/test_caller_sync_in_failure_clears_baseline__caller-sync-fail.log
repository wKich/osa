<tmp>/<entry><pid>
<case>/sandbox/tasks/.maki-oss/caller/<key>-bundle
@env MAKI_OSS_IDLE_STOP
@env MAKI_OSS_IMAGE
@env MAKI_OSS_INTERACTIVE
@env MAKI_OSS_POLICY
@env MAKI_OSS_PROVIDERS
@env MAKI_OSS_RUN_TAG
@env MAKI_OSS_SANDBOX_NAME
@env MAKI_OSS_TEST_ENV_VALUE
@env MAKI_OSS_TIMEOUT
@env MAKI_OSS_TUI
@env MAKI_OSS_WORKDIR
@env MAKI_OSS_WORKSPACE
@env MAKI_VERSION
---
sandbox
exec
-n
repo-app
--no-login-shell
--
sh
-c
set -e
gitdir=$1 worktree=$2 repodir=$3 bundle=$4 commit=$5 base_name=$6 base_ref=$7 base_commit=$8
trap 'rm -f "$bundle"' EXIT
rm -rf "$repodir" "$worktree/.git"
mkdir -p "$repodir" "$worktree"
git init -q --separate-git-dir="$repodir" "$worktree"
git --git-dir="$repodir" fetch -q --no-tags "$bundle" HEAD
if [ -n "$base_ref" ]; then
    git --git-dir="$repodir" fetch -q --no-tags "$bundle" "$base_ref"
fi
git --git-dir="$repodir" update-ref --no-deref HEAD "$commit"
if [ -n "$base_name" ]; then
    git --git-dir="$repodir" update-ref "refs/remotes/origin/$base_name" "$base_commit"
fi
GIT_DIR=$repodir GIT_WORK_TREE=$worktree git read-tree "$commit"
GIT_DIR=$repodir GIT_WORK_TREE=$worktree git reset -q --mixed
maki-oss-git
<case>/sandbox/tasks/.maki-oss/caller/<key>
<case>/sandbox/tasks/t1
<case>/sandbox/tasks/.maki-oss/caller/<key>-repo
<case>/sandbox/tasks/.maki-oss/caller/<key>-bundle
<commit>



@env MAKI_OSS_IDLE_STOP
@env MAKI_OSS_IMAGE
@env MAKI_OSS_INTERACTIVE
@env MAKI_OSS_POLICY
